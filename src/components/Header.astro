---
// Header.astro
---

<header class="sticky top-0 z-50 bg-epic-blue shadow-lg border-b border-white/10 transition-all duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-12 flex items-center justify-between h-20">
    
    <!-- Logo -->
    <a href="#" class="group flex flex-col items-start focus:outline-none">
      <div class="font-black text-2xl tracking-tighter text-white flex items-baseline">
        EPIC<span class="text-epic-gold group-hover:text-epic-gold-light transition-colors">RIDES</span>
      </div>
      <span class="font-mono text-[9px] tracking-[0.35em] text-white/50 -mt-1 uppercase">ECUADOR</span>
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="hidden lg:flex items-center gap-6 xl:gap-8 text-xs font-bold tracking-wider text-white/80">
      <a href="#sec-nosotros" class="hover:text-epic-gold transition-colors py-2 uppercase">Sobre Nosotros</a>
      <a href="#sec-calendario" class="hover:text-epic-gold transition-colors py-2 uppercase">Paseos Épicos</a>
      <a href="#sec-transporte" class="hover:text-epic-gold transition-colors py-2 uppercase">Transporte</a>
      <a href="#sec-coaching" class="hover:text-epic-gold transition-colors py-2 uppercase">Training &amp; Coaching</a>
    </nav>

    <!-- CTA & Mobile/Tablet Toggle -->
    <div class="flex items-center gap-3 sm:gap-4">
      <a 
        href="#sec-footer"
        class="bg-epic-gold hover:bg-epic-gold-light text-epic-blue font-extrabold text-xs tracking-wider px-4 py-2.5 sm:px-6 sm:py-3 rounded-full transition-all duration-200 transform hover:scale-105 shadow-md hover:shadow-epic-gold/20 uppercase inline-block text-center"
      >
        Contacto
      </a>

      <!-- Hamburger Button (Mobile & Tablet < 1024px) -->
      <button 
        id="mobile-menu-btn"
        type="button" 
        class="lg:hidden text-white hover:text-epic-gold p-2 focus:outline-none rounded-xl hover:bg-white/10 transition-colors"
        aria-label="Abrir menú"
        aria-expanded="false"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path id="menu-icon-bars" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          <path id="menu-icon-close" class="hidden" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

  </div>

  <!-- Mobile & Tablet Drawer Menu (< 1024px) -->
  <div id="mobile-menu" class="hidden lg:hidden bg-epic-blue/98 backdrop-blur-xl border-b border-white/10 px-6 py-6 sm:px-12 sm:py-8 shadow-2xl transition-all duration-300">
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 pb-4">
      <a href="#sec-nosotros" class="mobile-nav-link flex items-center justify-between text-sm sm:text-base font-bold text-white/90 hover:text-epic-gold hover:bg-white/5 px-4 py-3 rounded-xl transition-all uppercase">
        <span>Sobre Nosotros</span>
        <span class="text-epic-gold/60 text-xs">→</span>
      </a>
      <a href="#sec-calendario" class="mobile-nav-link flex items-center justify-between text-sm sm:text-base font-bold text-white/90 hover:text-epic-gold hover:bg-white/5 px-4 py-3 rounded-xl transition-all uppercase">
        <span>Paseos Épicos</span>
        <span class="text-epic-gold/60 text-xs">→</span>
      </a>
      <a href="#sec-transporte" class="mobile-nav-link flex items-center justify-between text-sm sm:text-base font-bold text-white/90 hover:text-epic-gold hover:bg-white/5 px-4 py-3 rounded-xl transition-all uppercase">
        <span>Transporte</span>
        <span class="text-epic-gold/60 text-xs">→</span>
      </a>
      <a href="#sec-coaching" class="mobile-nav-link flex items-center justify-between text-sm sm:text-base font-bold text-white/90 hover:text-epic-gold hover:bg-white/5 px-4 py-3 rounded-xl transition-all uppercase">
        <span>Training &amp; Coaching</span>
        <span class="text-epic-gold/60 text-xs">→</span>
      </a>
    </div>

    <div class="pt-4 border-t border-white/10 flex flex-col sm:flex-row gap-3 items-center justify-between">
      <span class="text-white/50 text-xs font-mono tracking-wider uppercase text-center sm:text-left">
        EPIC RIDES ECUADOR &bull; LOGÍSTICA &amp; AVENTURA
      </span>
      <a 
        href="#sec-footer"
        onclick="document.getElementById('mobile-menu')?.classList.add('hidden');" 
        class="w-full sm:w-auto px-8 bg-epic-gold hover:bg-epic-gold-light text-epic-blue font-extrabold text-xs tracking-wider py-3.5 rounded-full text-center uppercase shadow-md transition-all"
      >
        Contacto Inmediato
      </a>
    </div>
  </div>
</header>

<script>
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const barsIcon = document.getElementById('menu-icon-bars');
  const closeIcon = document.getElementById('menu-icon-close');

  if (menuBtn && mobileMenu) {
    menuBtn.addEventListener('click', () => {
      const isHidden = mobileMenu.classList.contains('hidden');
      mobileMenu.classList.toggle('hidden');
      barsIcon?.classList.toggle('hidden');
      closeIcon?.classList.toggle('hidden');
      menuBtn.setAttribute('aria-expanded', String(isHidden));
    });

    document.querySelectorAll('.mobile-nav-link').forEach(link => {
      link.addEventListener('click', () => {
        mobileMenu.classList.add('hidden');
        barsIcon?.classList.remove('hidden');
        closeIcon?.classList.add('hidden');
        menuBtn.setAttribute('aria-expanded', 'false');
      });
    });
  }
</script>
