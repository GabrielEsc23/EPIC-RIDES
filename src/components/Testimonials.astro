---
// Testimonials.astro
import { Image, getImage } from 'astro:assets';
import bgImg from '../assets/hero_andes_ride.jpg';
import poster1 from '../assets/comunidad/galeria-chimbo-llegada.jpg';
import poster2 from '../assets/hero/hero-andes-peloton.jpg';

const poster1Opt = await getImage({ src: poster1, width: 480, format: 'webp', quality: 70 });
const poster2Opt = await getImage({ src: poster2, width: 480, format: 'webp', quality: 70 });

const testimonialVideos = [
  {
    id: 1,
    tag: "RETO 0 - 5.000M · TESTIMONIO REAL",
    title: "Llegada al Chimborazo",
    desc: "La emoción inigualable y la satisfacción de coronar el coloso andino pedaleando desde el nivel del mar con el soporte y logística total de EPIC Rides.",
    videoSrc: "/images/web/testimonios/testimonio-llegada-chimborazo.mp4",
    poster: poster1Opt.src
  },
  {
    id: 2,
    tag: "COMUNIDAD EPIC · TESTIMONIO REAL",
    title: "La Experiencia en Ruta",
    desc: "La tranquilidad y disfrute de viajar en pelotón: asistencia mecánica permanente, puntos de hidratación, camioneta escolta y un ambiente familiar único.",
    videoSrc: "/images/web/testimonios/testimonio-experiencia-epic.mp4",
    poster: poster2Opt.src
  }
];
---

<section 
  id="sec-testimoniales" 
  class="relative py-20 lg:py-28 text-white overflow-hidden border-b border-white/10 bg-epic-blue"
>
  <!-- Background Image with Ambient Effect (Optimized with Astro Assets) -->
  <div class="absolute inset-0 z-0">
    <Image 
      src={bgImg} 
      alt="Fondo Testimoniales Andes EPIC Rides" 
      class="w-full h-full object-cover object-center filter brightness-40 contrast-110"
      widths={[480, 768, 1200, 1600]}
      sizes="100vw"
      quality={70}
      format="webp"
    />
    <div class="absolute inset-0 bg-epic-blue/80 backdrop-blur-[1px]"></div>
    <div class="absolute inset-0 bg-gradient-to-b from-epic-blue via-transparent to-epic-blue pointer-events-none"></div>
  </div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-12">
    
    <!-- Header -->
    <div class="max-w-3xl mb-12">
      <h2 class="font-black text-3xl sm:text-5xl lg:text-6xl tracking-tight leading-tight">
        LA COMUNIDAD LO CUENTA MEJOR
      </h2>
      <p class="text-white/80 text-base sm:text-lg mt-3">
        Testimonios y vivencias reales grabadas en ruta por ciclistas que han vivido la experiencia EPIC Rides.
      </p>
    </div>

    <!-- 2 Real Testimonial Videos Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-12 max-w-5xl mx-auto">
      {testimonialVideos.map((item) => (
        <div class="group bg-epic-blue-card/90 backdrop-blur-md rounded-3xl overflow-hidden border border-white/15 hover:border-epic-gold/50 transition-all duration-300 shadow-2xl flex flex-col justify-between">
          
          <!-- Video Container -->
          <div class="relative aspect-video sm:aspect-[16/10] bg-black overflow-hidden">
            <video 
              src={item.videoSrc}
              controls
              playsinline
              preload="metadata"
              poster={item.poster}
              class="w-full h-full object-cover"
            >
              Tu navegador no soporta reproducción de video HTML5.
            </video>
          </div>

          <!-- Video Details & Fullscreen Button -->
          <div class="p-6 sm:p-8 flex flex-col justify-between flex-1 gap-4">
            <div>
              <span class="font-mono text-[11px] font-bold tracking-wider text-epic-gold uppercase bg-white/10 px-3 py-1 rounded-md inline-block mb-3">
                {item.tag}
              </span>
              <h3 class="font-black text-xl sm:text-2xl text-white leading-snug">
                {item.title}
              </h3>
              <p class="text-white/80 text-sm sm:text-base leading-relaxed mt-2">
                {item.desc}
              </p>
            </div>

            <div class="pt-3 border-t border-white/10 flex items-center justify-between">
              <button 
                type="button"
                onclick={`window.openVideoModal('${item.videoSrc}', '${item.title} — EPIC Rides')`}
                class="inline-flex items-center gap-2 text-xs font-mono font-bold text-epic-gold hover:text-white uppercase tracking-wider transition-colors cursor-pointer"
              >
                <span>Ver en pantalla completa</span>
                <span>↗</span>
              </button>
            </div>
          </div>

        </div>
      ))}
    </div>

  </div>
</section>
