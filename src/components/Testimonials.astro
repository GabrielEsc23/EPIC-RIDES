---
// Testimonials.astro
import { getImage } from 'astro:assets';
import bgParallax from '../assets/testimonios/fondo-parallax-andes.jpg';
const bgParallaxOpt = await getImage({ src: bgParallax, width: 1920, format: 'webp', quality: 75 });

const testimonialVideos = [
  {
    id: 1,
    tag: "ALAUSÍ – AMBATO · EXPERIENCIAS ÚNICAS",
    title: "La Experiencia de Max en Alausí – Ambato",
    desc: "Max comparte su vivencia en la desafiante ruta Alausí – Ambato: paisajes espectaculares de la serranía, la exigencia física y cómo el acompañamiento cercano y logística de EPIC Rides hicieron inolvidable su trayecto.",
    videoSrc: "https://res.cloudinary.com/dlya09ut7/video/upload/f_auto,q_auto,w_720,c_limit/v1791081471/experiencias_unicas_alausi_znlr6q.mp4",
    poster: "/images/web/testimonios/poster-alausi.webp"
  },
  {
    id: 2,
    tag: "VOCES DE LA COMUNIDAD · TESTIMONIOS",
    title: "Mix de Experiencias Épicas",
    desc: "Diferentes ciclistas comparten sus testimonios y vivencias en el pelotón: una recopilación de sensaciones genuinas, camaradería, seguridad y la alegría compartida de pedalear por el país.",
    videoSrc: "https://res.cloudinary.com/dlya09ut7/video/upload/f_auto,q_auto,w_720,c_limit/v1791081504/mix_eperiencias_x2wpuv.mp4",
    poster: "/images/web/testimonios/poster-mix.webp"
  },
  {
    id: 3,
    tag: "SUPERACIÓN PERSONAL · 260 KM",
    title: "Mis Primeros 260 Kilómetros",
    desc: "El testimonio de una ciclista que se enfrentó por primera vez a un reto extremo de 260 km: superó el cansancio y las dificultades del camino con el respaldo técnico, hidratación y motivación constante del equipo EPIC Rides.",
    videoSrc: "https://res.cloudinary.com/dlya09ut7/video/upload/f_auto,q_auto,w_720,c_limit/v1791081503/mis_primeros_260km_sj82ln.mp4",
    poster: "/images/web/testimonios/poster-260km.webp"
  },
  {
    id: 4,
    tag: "RETO 0 - 5.000M · TESTIMONIO REAL",
    title: "Llegada al Chimborazo",
    desc: "La emoción inigualable y la satisfacción de coronar el coloso andino pedaleando desde el nivel del mar con el soporte y logística total de EPIC Rides.",
    videoSrc: "https://res.cloudinary.com/dlya09ut7/video/upload/f_auto,q_auto,w_720,c_limit/v1791081490/Llegada_al_Chimbo_-_0_a_5000_bcu4re.mp4",
    poster: "/images/web/testimonios/poster-chimborazo.webp"
  },
  {
    id: 5,
    tag: "COMUNIDAD EPIC · TESTIMONIO REAL",
    title: "La Experiencia en Pelotón",
    desc: "La tranquilidad y disfrute de viajar en pelotón: asistencia mecánica permanente, puntos de hidratación, camioneta escolta y un ambiente familiar único.",
    videoSrc: "https://res.cloudinary.com/dlya09ut7/video/upload/f_auto,q_auto,w_720,c_limit/v1791081491/IMG_8785_fofvvb.mp4",
    poster: "/images/web/testimonios/poster-peloton.webp"
  }
];

// 3 copias para crear un carrusel circular infinito ultra fluido
const loopTestimonials = [...testimonialVideos, ...testimonialVideos, ...testimonialVideos];
---

<section 
  id="sec-testimoniales" 
  class="relative py-20 lg:py-28 text-white overflow-hidden border-b border-white/10 bg-epic-blue"
>
  <!-- Background Image with Parallax Effect -->
  <div 
    class="absolute inset-0 z-0 bg-cover bg-center bg-no-repeat testimonials-parallax"
    style={`background-image: url('${bgParallaxOpt.src}');`}
  >
    <div class="absolute inset-0 bg-epic-blue/80 backdrop-blur-[0.5px]"></div>
    <div class="absolute inset-0 bg-gradient-to-b from-epic-blue via-transparent to-epic-blue pointer-events-none"></div>
  </div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-12">
    
    <!-- Header with Prev/Next Controls -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-10">
      <div class="max-w-3xl">
        <span class="font-mono text-xs sm:text-sm font-bold tracking-[0.25em] text-epic-gold uppercase block mb-3">
          TESTIMONIOS EN PRIMERA PERSONA
        </span>
        <h2 class="font-black text-3xl sm:text-5xl lg:text-6xl tracking-tight leading-tight">
          LA COMUNIDAD LO CUENTA MEJOR
        </h2>
        <p class="text-white/80 text-base sm:text-lg mt-3">
          Videos testimoniales reales grabados en ruta. <strong>Haz clic en cualquiera de ellos para reproducirlo a pantalla completa con audio</strong>.
        </p>
      </div>

      <!-- Carousel Arrow Controls -->
      <div class="flex items-center gap-3">
        <button 
          id="testimonials-prev-btn"
          type="button"
          class="w-12 h-12 rounded-full border border-white/20 bg-epic-blue-card/80 hover:bg-epic-gold hover:text-epic-blue hover:border-epic-gold text-white flex items-center justify-center text-xl transition-all cursor-pointer shadow-lg focus:outline-none"
          aria-label="Testimonios anteriores"
        >
          ←
        </button>
        <button 
          id="testimonials-next-btn"
          type="button"
          class="w-12 h-12 rounded-full border border-white/20 bg-epic-blue-card/80 hover:bg-epic-gold hover:text-epic-blue hover:border-epic-gold text-white flex items-center justify-center text-xl transition-all cursor-pointer shadow-lg focus:outline-none"
          aria-label="Siguientes testimonios"
        >
          →
        </button>
      </div>
    </div>

    <!-- Infinite Carousel Track Container -->
    <div 
      id="testimonials-strip"
      class="flex gap-6 overflow-x-auto pb-8 select-none cursor-grab active:cursor-grabbing scrollbar-none"
      style="-webkit-overflow-scrolling: touch;"
    >
      {loopTestimonials.map((t, idx) => (
        <div 
          class="testimonial-card flex-none w-[320px] sm:w-[380px] md:w-[420px] rounded-3xl overflow-hidden border border-white/15 bg-epic-blue-card/90 backdrop-blur-md flex flex-col justify-between group transition-all duration-300 hover:border-epic-gold hover:shadow-2xl hover:-translate-y-1.5"
          data-index={idx}
        >
          
          <!-- Video Poster Container (Frame 0.01 como poster estático sin previsualización en movimiento) -->
          <div 
            class="testimonial-video-box relative aspect-video overflow-hidden bg-black cursor-pointer group/video select-none"
            onclick={`window.openVideoModal('${t.videoSrc}', '${t.title} — EPIC Rides')`}
            title="Haz clic para reproducir este testimonio con audio"
          >
            <img 
              src={t.poster} 
              alt={t.title}
              width="1280"
              height="720"
              loading="lazy"
              decoding="async"
              class="w-full h-full object-cover transition-transform duration-700 group-hover/video:scale-105 pointer-events-none"
            />

            <!-- Subtle Dark Gradient -->
            <div class="absolute inset-0 bg-gradient-to-t from-epic-blue-card/80 via-transparent to-black/30 pointer-events-none"></div>

            <!-- Central Play Button Badge -->
            <div class="absolute inset-0 m-auto w-14 h-14 rounded-full bg-epic-blue/90 border border-white/30 text-white flex items-center justify-center text-xl transition-all duration-300 shadow-2xl group-hover/video:bg-epic-gold group-hover/video:text-epic-blue group-hover/video:scale-110 group-hover/video:border-epic-gold pointer-events-none">
              <span class="ml-0.5 text-lg">▶</span>
            </div>
          </div>

          <!-- Video Details & Action Button -->
          <div class="p-6 sm:p-7 flex flex-col justify-between flex-1 gap-5">
            <div class="flex flex-col gap-2">
              <span class="font-mono text-[11px] font-bold tracking-wider text-epic-gold uppercase bg-white/10 px-3 py-1 rounded-md inline-block self-start">
                {t.tag}
              </span>
              <h3 class="font-black text-lg sm:text-xl text-white leading-snug">
                {t.title}
              </h3>
              <p class="text-white/80 text-sm sm:text-base leading-relaxed mt-1">
                {t.desc}
              </p>
            </div>

            <div class="pt-4 border-t border-white/10 flex items-center justify-between">
              <button 
                type="button"
                onclick={`window.openVideoModal('${t.videoSrc.split('#')[0]}', '${t.title} — EPIC Rides')`}
                class="inline-flex items-center gap-2 text-xs font-mono font-bold text-epic-gold hover:text-white uppercase tracking-wider transition-colors cursor-pointer"
              >
                <span>Ver testimonio</span>
                <span>▶</span>
              </button>
            </div>
          </div>

        </div>
      ))}
    </div>

  </div>
</section>

<style>
  .testimonials-parallax {
    background-attachment: fixed;
    background-position: center center;
    background-repeat: no-repeat;
    background-size: cover;
  }

  @supports (-webkit-touch-callout: none) {
    @media (max-width: 768px) {
      .testimonials-parallax {
        background-attachment: scroll;
      }
    }
  }

  #testimonials-strip {
    -ms-overflow-style: none; /* IE and Edge */
    scrollbar-width: none; /* Firefox */
  }
  #testimonials-strip::-webkit-scrollbar {
    display: none; /* Chrome, Safari and Opera */
  }
</style>

<script>
  const tStrip = document.getElementById('testimonials-strip') as HTMLElement | null;
  const prevBtn = document.getElementById('testimonials-prev-btn');
  const nextBtn = document.getElementById('testimonials-next-btn');
  const secTestimonios = document.getElementById('sec-testimoniales');

  if (tStrip) {
    // 1. Dimensiones cacheadas en memoria para eliminar lecturas de layout forzadas (0 Forced Reflow)
    let cachedSetWidth = 0;
    let currentScrollX = 0;
    let isPaused = false;
    let isInteracting = false;
    let isVisible = false;
    let rafId: number | null = null;
    let interactionTimeout: ReturnType<typeof setTimeout> | undefined;
    const speed = 0.6; // Desplazamiento continuo suave

    const updateMetrics = () => {
      if (tStrip) {
        cachedSetWidth = tStrip.scrollWidth / 3;
      }
    };

    // Centrar en el set 2 para permitir scroll tanto hacia adelante como hacia atrás
    const initPosition = () => {
      updateMetrics();
      if (cachedSetWidth > 0 && tStrip) {
        currentScrollX = cachedSetWidth;
        tStrip.scrollLeft = currentScrollX;
      }
    };

    if (document.readyState === 'complete') {
      initPosition();
    } else {
      window.addEventListener('load', initPosition);
    }
    setTimeout(initPosition, 100);

    const pauseTemporarily = (ms = 3500) => {
      isInteracting = true;
      if (interactionTimeout) clearTimeout(interactionTimeout);
      interactionTimeout = setTimeout(() => {
        isInteracting = false;
        if (tStrip) {
          currentScrollX = tStrip.scrollLeft;
        }
      }, ms);
    };

    // Wrap de bucle infinito controlado 100% en memoria
    const checkInfiniteWrap = () => {
      if (!cachedSetWidth) return;
      if (currentScrollX >= 2 * cachedSetWidth) {
        currentScrollX -= cachedSetWidth;
        if (tStrip) tStrip.scrollLeft = currentScrollX;
      } else if (currentScrollX <= cachedSetWidth * 0.25) {
        currentScrollX += cachedSetWidth;
        if (tStrip) tStrip.scrollLeft = currentScrollX;
      }
    };

    // Animación continua con requestAnimationFrame (0 lecturas del DOM dentro del loop activo)
    const autoScroll = () => {
      if (!isPaused && !isInteracting && isVisible && tStrip) {
        currentScrollX += speed;
        tStrip.scrollLeft = currentScrollX;
        checkInfiniteWrap();
      }
      if (isVisible) {
        rafId = requestAnimationFrame(autoScroll);
      }
    };

    const startAnimation = () => {
      if (!rafId && isVisible) {
        rafId = requestAnimationFrame(autoScroll);
      }
    };

    const stopAnimation = () => {
      if (rafId) {
        cancelAnimationFrame(rafId);
        rafId = null;
      }
    };

    // IntersectionObserver: el carrusel SOLO corre si el usuario lo está viendo en pantalla
    if (secTestimonios && 'IntersectionObserver' in window) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          isVisible = entry.isIntersecting;
          if (isVisible) {
            updateMetrics();
            if (currentScrollX === 0 && tStrip) {
              currentScrollX = tStrip.scrollLeft;
            }
            startAnimation();
          } else {
            stopAnimation();
          }
        });
      }, { rootMargin: '100px 0px' });
      observer.observe(secTestimonios);
    } else {
      isVisible = true;
      startAnimation();
    }

    // Pausar al pasar el mouse por encima
    tStrip.addEventListener('mouseenter', () => {
      isPaused = true;
    });

    tStrip.addEventListener('mouseleave', () => {
      isPaused = false;
      if (tStrip) currentScrollX = tStrip.scrollLeft;
    });

    // Botones de navegación prev/next
    prevBtn?.addEventListener('click', () => {
      pauseTemporarily(4000);
      tStrip.scrollBy({ left: -420, behavior: 'smooth' });
      setTimeout(() => {
        if (tStrip) currentScrollX = tStrip.scrollLeft;
        checkInfiniteWrap();
      }, 400);
    });

    nextBtn?.addEventListener('click', () => {
      pauseTemporarily(4000);
      tStrip.scrollBy({ left: 420, behavior: 'smooth' });
      setTimeout(() => {
        if (tStrip) currentScrollX = tStrip.scrollLeft;
        checkInfiniteWrap();
      }, 400);
    });

    // Touch en móviles
    tStrip.addEventListener('touchstart', () => {
      isPaused = true;
      isInteracting = true;
    }, { passive: true });

    tStrip.addEventListener('touchend', () => {
      isPaused = false;
      if (tStrip) currentScrollX = tStrip.scrollLeft;
      checkInfiniteWrap();
      pauseTemporarily(2500);
    }, { passive: true });

    tStrip.addEventListener('scroll', () => {
      if (isInteracting && tStrip) {
        currentScrollX = tStrip.scrollLeft;
        checkInfiniteWrap();
      }
    }, { passive: true });

    // Drag con mouse
    let isDown = false;
    let startX = 0;
    let scrollLeftStart = 0;
    let draggedDistance = 0;

    tStrip.addEventListener('mousedown', (e) => {
      isDown = true;
      isInteracting = true;
      draggedDistance = 0;
      startX = e.pageX - tStrip.offsetLeft;
      scrollLeftStart = tStrip.scrollLeft;
    });

    window.addEventListener('mouseup', () => {
      if (isDown) {
        isDown = false;
        if (tStrip) currentScrollX = tStrip.scrollLeft;
        pauseTemporarily(2500);
      }
    });

    tStrip.addEventListener('mousemove', (e) => {
      if (!isDown || !tStrip) return;
      const x = e.pageX - tStrip.offsetLeft;
      const walk = (x - startX);
      draggedDistance = Math.abs(walk);
      if (draggedDistance > 5) {
        e.preventDefault();
        currentScrollX = scrollLeftStart - (walk * 1.3);
        tStrip.scrollLeft = currentScrollX;
        checkInfiniteWrap();
      }
    });

    // Ajustar en redimensionamiento de pantalla (con debounce)
    let resizeTimer: ReturnType<typeof setTimeout> | undefined;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(() => {
        updateMetrics();
        checkInfiniteWrap();
      }, 150);
    });

  }
</script>
