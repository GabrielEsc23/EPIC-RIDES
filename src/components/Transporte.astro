---
// Transporte.astro
import { Image } from 'astro:assets';
import img1 from '../assets/transporte/transporte-1.jpg';
import img2 from '../assets/transporte/transporte-2.jpg';
import img3 from '../assets/transporte/transporte-3.jpg';
import img4 from '../assets/transporte/transporte-4.jpg';
import img5 from '../assets/transporte/transporte-5.jpg';

const transporteSlides = [
  {
    num: "01",
    label: "Epic Van equipada con racks profesionales para bicicletas",
    img: img1,
    pos: "object-center"
  },
  {
    num: "02",
    label: "Transporte seguro sin necesidad de desmontar ruedas ni cuadros",
    img: img2,
    pos: "object-center"
  },
  {
    num: "03",
    label: "Espacio y anclajes acolchados para evitar golpes o roces",
    img: img3,
    pos: "object-center"
  },
  {
    num: "04",
    label: "Capacidad para hasta 14 pasajeros y sus bicicletas con total comodidad",
    img: img4,
    pos: "object-center"
  },
  {
    num: "05",
    label: "Logística y cuidado minucioso para bicicletas de Ruta, MTB y Gravel",
    img: img5,
    pos: "object-center"
  }
];

const highlights = [
  {
    title: "Hasta 14 pasajeros",
    desc: "Espacio amplio y cómodo para todo tu equipo o grupo de amigos con climatización y confort."
  },
  {
    title: "Sin desarmar tu bici",
    desc: "Tu bicicleta viaja completa y lista para rodar apenas lleguemos a la ruta."
  },
  {
    title: "Cero golpes o roces",
    desc: "Anclajes individuales acolchados que eliminan cualquier contacto entre bicicletas."
  },
  {
    title: "Seguridad y confianza",
    desc: "Chofer profesional, furgoneta monitoreada y protocolos de sujeción técnica."
  }
];
---

<section id="sec-transporte" class="py-20 lg:py-28 bg-white border-b border-epic-blue/10 scroll-mt-20 overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-12">
    
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
      
      <!-- Contenido textual (Izquierda 6/12 o 7/12) -->
      <div class="lg:col-span-6 flex flex-col gap-6 justify-center">
        
        <div id="transporte-title-block" class="opacity-0 translate-y-6 transition-all duration-700 ease-out">
          <span class="inline-flex items-center gap-2 font-mono text-xs sm:text-sm font-bold tracking-[0.25em] text-epic-gold uppercase bg-epic-blue/5 border border-epic-blue/10 px-4 py-1.5 rounded-full mb-4">
            LOGÍSTICA & TRANSPORTE ESPECIALIZADO
          </span>
          <h2 class="font-black text-3xl sm:text-5xl lg:text-[44px] tracking-tight text-epic-blue leading-[1.08]">
            TRANSPORTE ESPECIALIZADO <span class="text-epic-gold inline-block">PARA TU BICICLETA</span>
          </h2>
          <div id="transporte-accent-line" class="h-1 bg-epic-gold rounded-full mt-3 w-0 transition-all duration-700 delay-300"></div>
        </div>

        <div id="transporte-body-block" class="opacity-0 translate-y-6 transition-all duration-700 delay-150 ease-out flex flex-col gap-6">
          <p class="text-epic-text-muted text-base sm:text-lg leading-relaxed">
            Sabemos lo importante que es tu bicicleta y la confianza que necesitas al momento de transportarla. Por eso, en <strong class="text-epic-blue font-bold">Epic Rides</strong> contamos con un servicio especializado diseñado para llevarla de forma segura, cómoda y confiable.
          </p>

          <p class="text-epic-text-muted text-base leading-relaxed">
            Nuestra <strong class="text-epic-blue font-bold">Epic Van</strong> además de transportar hasta <strong class="text-epic-blue font-bold">14 pasajeros cómodamente</strong>, ha sido especialmente adecuada para transportar las bicicletas <strong class="text-epic-blue font-bold">sin necesidad de desarmarlas</strong>, con el espacio necesario para evitar golpes, roces o contacto entre ellas.
          </p>

          <div class="border-l-4 border-epic-gold pl-4 py-1 bg-epic-gray-bg/60 rounded-r-xl">
            <p class="text-epic-blue text-sm sm:text-base leading-relaxed font-bold italic">
              "Porque tu bicicleta no es solo un medio de transporte: es parte de tu pasión. Nosotros nos encargamos de llevarla con el cuidado y la seguridad que merece."
            </p>
          </div>

          <!-- 4 Ventajas Destacadas en Grid -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5 pt-2">
            {highlights.map((h, i) => (
              <div 
                class="transporte-feature-card p-3.5 rounded-2xl bg-epic-gray-bg border border-epic-blue/10 flex flex-col gap-1 transition-all hover:border-epic-gold hover:shadow-md opacity-0 translate-y-4 duration-500 ease-out"
                data-card-index={i}
              >
                <div class="flex items-center gap-2 text-epic-blue font-bold text-xs sm:text-sm">
                  <span class="text-epic-gold text-base">✓</span>
                  <span>{h.title}</span>
                </div>
                <p class="text-[12px] sm:text-xs text-epic-text-muted leading-snug pl-5">
                  {h.desc}
                </p>
              </div>
            ))}
          </div>
        </div>

      </div>

      <!-- Vitrina Interactiva de Fotografías (Derecha 6/12) -->
      <div class="lg:col-span-6 flex flex-col justify-center">
        
        <!-- Carrusel Principal con Contenedor Responsivo -->
        <div id="transporte-carousel-col" class="transporte-carousel-container relative h-[360px] sm:h-[460px] lg:h-[530px] w-full rounded-3xl overflow-hidden shadow-2xl bg-epic-blue-card group select-none border border-epic-blue/15 opacity-0 translate-x-8 transition-all duration-700 ease-out">
          
          <!-- Slides -->
          <div id="transporte-slides-container" class="relative w-full h-full">
            {transporteSlides.map((slide, index) => (
              <div 
                class={`transporte-slide absolute inset-0 transition-opacity duration-700 ease-in-out ${index === 0 ? 'opacity-100 z-10' : 'opacity-0 z-0'}`}
                data-index={index}
              >
                <Image 
                  src={slide.img} 
                  alt={slide.label} 
                  width={640}
                  height={530}
                  widths={[360, 480, 640, 800]}
                  sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 640px"
                  quality={60}
                  format="webp"
                  loading={index === 0 ? "eager" : "lazy"}
                  decoding="async"
                  class={`w-full h-full object-cover ${slide.pos || 'object-center'} group-hover:scale-105 transition-transform duration-700 ease-out`}
                />
              </div>
            ))}
          </div>

          <!-- Contador de Fotos en Esquina Superior Derecha -->
          <div class="absolute top-4 right-4 z-20 pointer-events-none">
            <span id="transporte-counter" class="inline-flex items-center bg-black/60 backdrop-blur-md text-white font-mono font-bold text-[11px] sm:text-xs px-3 py-1 rounded-full shadow-lg border border-white/15">
              1 / {transporteSlides.length}
            </span>
          </div>

          <!-- Botones de Navegación Izquierda / Derecha -->
          <div class="absolute inset-x-3 top-1/2 -translate-y-1/2 flex items-center justify-between z-20 pointer-events-none">
            <button 
              type="button" 
              id="transporte-prev-btn"
              class="pointer-events-auto w-10 h-10 sm:w-11 sm:h-11 rounded-full bg-black/50 hover:bg-epic-gold hover:text-epic-blue text-white flex items-center justify-center backdrop-blur-md border border-white/20 shadow-xl transition-all transform hover:scale-110 cursor-pointer focus:outline-none"
              aria-label="Foto anterior de transporte"
            >
              ←
            </button>
            <button 
              type="button" 
              id="transporte-next-btn"
              class="pointer-events-auto w-10 h-10 sm:w-11 sm:h-11 rounded-full bg-black/50 hover:bg-epic-gold hover:text-epic-blue text-white flex items-center justify-center backdrop-blur-md border border-white/20 shadow-xl transition-all transform hover:scale-110 cursor-pointer focus:outline-none"
              aria-label="Siguiente foto de transporte"
            >
              →
            </button>
          </div>

        </div>

      </div>

    </div>

  </div>
</section>

<script>
  let currentTransporteSlide = 0;
  const slides = document.querySelectorAll('.transporte-slide');
  const counter = document.getElementById('transporte-counter');
  const prevBtn = document.getElementById('transporte-prev-btn');
  const nextBtn = document.getElementById('transporte-next-btn');
  const totalSlides = slides.length;
  let autoplayTimer: any;

  function showTransporteSlide(index: number) {
    if (index < 0) index = totalSlides - 1;
    if (index >= totalSlides) index = 0;

    // Pre-cargar la imagen si aún estaba en lazy
    const activeImg = slides[index]?.querySelector('img');
    if (activeImg instanceof HTMLImageElement && activeImg.loading === 'lazy') {
      activeImg.loading = 'eager';
    }

    slides.forEach((s, i) => {
      if (i === index) {
        s.classList.remove('opacity-0', 'z-0');
        s.classList.add('opacity-100', 'z-10');
      } else {
        s.classList.remove('opacity-100', 'z-10');
        s.classList.add('opacity-0', 'z-0');
      }
    });

    if (counter) {
      counter.textContent = `${index + 1} / ${totalSlides}`;
    }

    currentTransporteSlide = index;
  }

  function nextSlide() {
    showTransporteSlide((currentTransporteSlide + 1) % totalSlides);
  }

  function prevSlide() {
    showTransporteSlide((currentTransporteSlide - 1 + totalSlides) % totalSlides);
  }

  function startAutoplay() {
    clearInterval(autoplayTimer);
    autoplayTimer = setInterval(nextSlide, 5000);
  }

  function resetAutoplay() {
    clearInterval(autoplayTimer);
    startAutoplay();
  }

  if (prevBtn) {
    prevBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      prevSlide();
      resetAutoplay();
    });
  }

  if (nextBtn) {
    nextBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      nextSlide();
      resetAutoplay();
    });
  }

  const container = document.querySelector('.transporte-carousel-container');
  if (container) {
    container.addEventListener('mouseenter', () => clearInterval(autoplayTimer));
    container.addEventListener('mouseleave', () => startAutoplay());

    // Soporte táctil / swipe para dispositivos móviles
    let touchStartX = 0;
    let touchEndX = 0;

    container.addEventListener('touchstart', (e: TouchEvent) => {
      touchStartX = e.changedTouches[0].screenX;
      clearInterval(autoplayTimer);
    }, { passive: true });

    container.addEventListener('touchend', (e: TouchEvent) => {
      touchEndX = e.changedTouches[0].screenX;
      const diff = touchStartX - touchEndX;
      if (Math.abs(diff) > 40) {
        if (diff > 0) nextSlide();
        else prevSlide();
      }
      startAutoplay();
    }, { passive: true });
  }

  startAutoplay();

  // Scroll entrance observer for Transporte section
  const transporteSection = document.getElementById('sec-transporte');
  if (transporteSection && 'IntersectionObserver' in window) {
    const transporteObserver = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const titleBlock = document.getElementById('transporte-title-block');
          const accentLine = document.getElementById('transporte-accent-line');
          const bodyBlock = document.getElementById('transporte-body-block');
          const carouselCol = document.getElementById('transporte-carousel-col');
          const featureCards = document.querySelectorAll('.transporte-feature-card');

          if (titleBlock) {
            titleBlock.classList.remove('opacity-0', 'translate-y-6');
            titleBlock.classList.add('opacity-100', 'translate-y-0');
          }
          if (accentLine) {
            accentLine.classList.remove('w-0');
            accentLine.classList.add('w-24');
          }
          if (bodyBlock) {
            bodyBlock.classList.remove('opacity-0', 'translate-y-6');
            bodyBlock.classList.add('opacity-100', 'translate-y-0');
          }
          if (carouselCol) {
            carouselCol.classList.remove('opacity-0', 'translate-x-8');
            carouselCol.classList.add('opacity-100', 'translate-x-0');
          }

          featureCards.forEach((card, idx) => {
            setTimeout(() => {
              card.classList.remove('opacity-0', 'translate-y-4');
              card.classList.add('opacity-100', 'translate-y-0');
            }, 250 + idx * 120);
          });

          transporteObserver.unobserve(entry.target);
        }
      });
    }, { threshold: 0.15, rootMargin: '0px 0px -40px 0px' });

    transporteObserver.observe(transporteSection);
  } else {
    // Fallback if no IntersectionObserver
    const titleBlock = document.getElementById('transporte-title-block');
    const accentLine = document.getElementById('transporte-accent-line');
    const bodyBlock = document.getElementById('transporte-body-block');
    const carouselCol = document.getElementById('transporte-carousel-col');
    const featureCards = document.querySelectorAll('.transporte-feature-card');
    if (titleBlock) titleBlock.classList.remove('opacity-0', 'translate-y-6');
    if (accentLine) accentLine.classList.remove('w-0');
    if (bodyBlock) bodyBlock.classList.remove('opacity-0', 'translate-y-6');
    if (carouselCol) carouselCol.classList.remove('opacity-0', 'translate-x-8');
    featureCards.forEach(c => c.classList.remove('opacity-0', 'translate-y-4'));
  }
</script>
