// Mosaico expandible (7 elementos adicionales: 2 videos + 5 fotos)
const expandedItems = [
  {
    type: 'video',
    span: 'col-span-1',
    videoUrl: videos[3].url,
    videoPoster: videos[3].poster,
    title: videos[3].title,
    subtitle: videos[3].subtitle,
    videoDuration: videos[3].duration
  },
  {
    type: 'video',
    span: 'col-span-1',
