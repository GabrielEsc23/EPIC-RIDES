    poster: "https://res.cloudinary.com/dlya09ut7/video/upload/so_8,w_1200,c_fill,q_auto,f_auto,e_improve,e_sharpen:90/v1791143323/videoGaleria_3_u4a3r3.jpg",
    title: "Ritmo y Descenso en Carretera",
