    poster: "https://res.cloudinary.com/dlya09ut7/video/upload/so_1,w_1200,c_fill,q_auto,f_auto,e_sharpen:80/v1791143377/video_galeria_4_eygtlv.jpg",
    title: "Travesía y Altura Andina",
