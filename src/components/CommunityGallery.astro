    url: "https://res.cloudinary.com/dlya09ut7/video/upload/f_auto,q_auto,w_720,c_limit/v1791143340/video_galeria_5_qalazt.mp4",
    poster: "https://res.cloudinary.com/dlya09ut7/video/upload/so_1,w_1200,c_fill,q_auto,f_auto,e_sharpen:80/v1791143340/video_galeria_5_qalazt.jpg",
    title: "Compañerismo y Pasión Ciclista",
    subtitle: "Comunidad en Ruta"
  }
];

// Importación de fotos de la comunidad y expediciones
import gal1 from '../assets/comunidad/galeria-quilotoa-mirador.jpg';
import gal2 from '../assets/servicios/transporte-epic-van.jpg';
import gal3 from '../assets/comunidad/galeria-chimbo-llegada.jpg';
import gal6 from '../assets/comunidad/galeria-playa-celebracion.jpg';
import gal7 from '../assets/nosotros/campamento-fogata.jpg';
import gal9 from '../assets/paseos/carchi-1.jpg';

// Nuevas fotos agregadas en src/assets/comunidad/
import gal14 from '../assets/comunidad/foto_galeria_1.jpg';
import gal15 from '../assets/comunidad/de_0_500_galeria.jpg';
import gal16 from '../assets/comunidad/de_0_500_galeria_2HEIC.jpg';

// Mosaico Principal (7 elementos iniciales: perfectamente balanceados para 3 filas completas)
const primaryItems = [
  {
    type: 'video',
    defaultSpan: 'col-span-1 md:col-span-2 md:row-span-2',
    videoFilterSpan: 'col-span-1 md:col-span-2',
    videoUrl: videos[0].url,
    videoPoster: videos[0].poster,
    title: videos[0].title,
    subtitle: videos[0].subtitle,
    isFeature: true
  },
  {
    type: 'photo',
    defaultSpan: 'col-span-1',
    photoSrc: gal14,
    photoIndex: 14,
    title: 'Comunidad y Familia Ciclista',
    subtitle: 'Comunidad EPIC',
    photoPos: 'object-[center_25%]'
  },
  {
    type: 'video',
    defaultSpan: 'col-span-1',
    videoFilterSpan: 'col-span-1',
    videoUrl: videos[1].url,
    videoPoster: videos[1].poster,
    title: videos[1].title,
    subtitle: videos[1].subtitle
  },
  {
    type: 'photo',
    defaultSpan: 'col-span-1',
    photoSrc: gal15,
    photoIndex: 15,
    title: 'Reto 0 a 5.000m · Rumbo al Chimborazo',
    subtitle: 'Reto 0 - 5.000m',
    photoPos: 'object-[center_30%]'
  },
  {
    type: 'photo',
    defaultSpan: 'col-span-1',
    photoSrc: gal16,
    photoIndex: 16,
    title: 'Conquistando la Cumbre Andina',
    subtitle: 'Glaciar Chimborazo',
    photoPos: 'object-[center_35%]'
  },
  {
    type: 'video',
    defaultSpan: 'col-span-1 md:col-span-2',
    videoFilterSpan: 'col-span-1',
    videoUrl: videos[2].url,
    videoPoster: videos[2].poster,
    title: videos[2].title,
    subtitle: videos[2].subtitle,
    filterClass: videos[2].filterClass
  },
  {
    type: 'photo',
    defaultSpan: 'col-span-1 md:col-span-2',
    photoSrc: gal6,
    photoIndex: 6,
    title: 'Llegada al Pacífico & Celebración',
    subtitle: 'Meta Costera',
    photoPos: 'object-[center_30%]'
  }
];

// Mosaico Expandible (7 elementos adicionales: completan 2 filas completas de 4 columnas)
const expandedItems = [
  {
    type: 'video',
    defaultSpan: 'col-span-1',
    videoFilterSpan: 'col-span-1 md:col-span-2',
    videoUrl: videos[3].url,
    videoPoster: videos[3].poster,
    title: videos[3].title,
    subtitle: videos[3].subtitle
  },
  {
    type: 'video',
    defaultSpan: 'col-span-1',
    videoFilterSpan: 'col-span-1 md:col-span-2',
    videoUrl: videos[4].url,
    videoPoster: videos[4].poster,
    title: videos[4].title,
    subtitle: videos[4].subtitle
  },
  {
    type: 'photo',
    defaultSpan: 'col-span-1 md:col-span-2',
    photoSrc: gal7,
    photoIndex: 7,
    title: 'Fogata y Paisaje',
    subtitle: 'Campamento Andino',
    photoPos: 'object-[center_75%]',
    filterClass: 'contrast-[1.08] brightness-[1.04] saturate-[1.12]'
  },
  {
    type: 'photo',
    defaultSpan: 'col-span-1',
    photoSrc: gal1,
    photoIndex: 1,
    title: 'Laguna del Quilotoa',
    subtitle: 'Cráter Volcánico',
    photoPos: 'object-center'
  },
  {
    type: 'photo',
    defaultSpan: 'col-span-1',
    photoSrc: gal2,
    photoIndex: 2,
    title: 'Racks especializados Epic Van',
    subtitle: 'Logística de Transporte',
    photoPos: 'object-[center_20%]'
  },
  {
    type: 'photo',
    defaultSpan: 'col-span-1',
    photoSrc: gal3,
    photoIndex: 3,
    title: 'Conquistando el Chimborazo',
    subtitle: 'Alta Montaña',
    photoPos: 'object-[center_30%]'
  },
  {
    type: 'photo',
    defaultSpan: 'col-span-1',
    photoSrc: gal9,
    photoIndex: 9,
    title: 'Puertos y Curvas del Carchi',
    subtitle: 'Páramos del Carchi',
    photoPos: 'object-center'
  }
];
---

<section id="sec-comunidad" class="py-20 lg:py-28 bg-white border-b border-epic-blue/10 scroll-mt-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-12">
    
    <!-- Header -->
    <div class="max-w-3xl mb-8">
      <div class="inline-flex items-center gap-2 font-mono text-xs font-bold tracking-[0.25em] text-epic-gold uppercase mb-2">
        Experiencias Reales en Ruta
      </div>
      <h2 class="font-black text-3xl sm:text-5xl lg:text-6xl tracking-tight text-epic-blue leading-tight">
        EPIC RIDES COMMUNITY
      </h2>
      <p class="text-epic-text-muted text-base mt-2">
        Momentos inolvidables sobre dos ruedas. Haz clic en cualquier elemento para reproducir el video con audio o ampliar la fotografía a pantalla completa.
      </p>
    </div>

    <!-- Filter Tabs (Sin emojis, limpios y elegantes) -->
    <div class="flex flex-wrap items-center gap-2.5 sm:gap-3 mb-8">
      <button 
        type="button" 
        class="gallery-filter-btn px-5 py-2.5 rounded-full font-extrabold text-xs tracking-wider uppercase transition-all duration-200 border cursor-pointer bg-epic-blue text-epic-gold border-epic-blue shadow-md"
        data-filter="all"
      >
        Todos
      </button>
      <button 
        type="button" 
        class="gallery-filter-btn px-5 py-2.5 rounded-full font-extrabold text-xs tracking-wider uppercase transition-all duration-200 border cursor-pointer bg-white text-epic-blue border-epic-blue/20 hover:border-epic-gold hover:text-epic-gold"
        data-filter="video"
      >
        Videos en Ruta
      </button>
      <button 
        type="button" 
        class="gallery-filter-btn px-5 py-2.5 rounded-full font-extrabold text-xs tracking-wider uppercase transition-all duration-200 border cursor-pointer bg-white text-epic-blue border-epic-blue/20 hover:border-epic-gold hover:text-epic-gold"
        data-filter="photo"
      >
        Fotografías
      </button>
    </div>

    <!-- Single Unified Gallery Grid with grid-flow-dense to eliminate any white holes -->
    <div id="gallery-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 auto-rows-[240px] grid-flow-dense">
      
      <!-- Primary Items (Always visible) -->
      {primaryItems.map((item) => (
        item.type === 'video' ? (
          <div 
            class={`${item.defaultSpan} gallery-card relative rounded-2xl overflow-hidden bg-epic-blue group cursor-pointer shadow-md hover:shadow-2xl transition-all duration-300 border border-epic-blue/10 hover:border-epic-gold/50 focus:outline-none focus:ring-2 focus:ring-epic-gold select-none`}
            data-type="video"
            data-default-span={item.defaultSpan}
            data-video-span={item.videoFilterSpan}
            role="button"
            tabindex="0"
            onclick={`window.openVideoModal('${item.videoUrl}', '${item.title}');`}
            onkeydown={`if(event.key==='Enter'||event.key===' ') { event.preventDefault(); window.openVideoModal('${item.videoUrl}', '${item.title}'); }`}
            aria-label={`Reproducir video: ${item.title}`}
          >
            <img 
              src={item.videoPoster} 
              alt={item.title} 
              width="1200"
              height="675"
              loading={item.isFeature ? "eager" : "lazy"} 
              decoding="async"
              class={`w-full h-full object-cover ${item.filterClass || ''} group-hover:scale-105 transition-transform duration-500`} 
            />
            <div class="absolute inset-0 bg-gradient-to-t from-epic-blue/90 via-black/20 to-black/25"></div>
            
            <!-- Central Gold Play Button without extra labels -->
            <div class={`absolute inset-0 m-auto ${item.isFeature ? 'w-20 h-20 text-3xl' : 'w-14 h-14 sm:w-16 sm:h-16 text-2xl'} rounded-full bg-epic-gold text-epic-blue flex items-center justify-center transition-all duration-300 transform group-hover:scale-110 shadow-2xl z-20 pointer-events-none group-hover:shadow-epic-gold/40`}>
              <span class="ml-1">▶</span>
            </div>

            <!-- Bottom Details -->
            <div class="absolute bottom-4 left-4 right-4 text-white z-10 drop-shadow">
              {item.subtitle && (
                <span class="font-mono text-[10px] text-epic-gold uppercase tracking-wider block">{item.subtitle}</span>
              )}
              <h3 class={`font-black ${item.isFeature ? 'text-lg sm:text-2xl' : 'text-sm sm:text-base'} leading-snug drop-shadow`}>
                {item.title}
              </h3>
            </div>
          </div>
        ) : (
          <div 
            class={`${item.defaultSpan} gallery-card relative rounded-2xl overflow-hidden bg-epic-blue group cursor-pointer shadow-md hover:shadow-2xl transition-all duration-300 border border-epic-blue/10 hover:border-epic-gold/40 focus:outline-none focus:ring-2 focus:ring-epic-gold select-none`}
            data-type="photo"
            data-default-span={item.defaultSpan}
            role="button"
            tabindex="0"
            onclick={`window.openImageModal(${item.photoIndex});`}
            onkeydown={`if(event.key==='Enter'||event.key===' ') { event.preventDefault(); window.openImageModal(${item.photoIndex}); }`}
            aria-label={`Ver fotografía ampliada: ${item.title}`}
          >
            <Image 
              src={item.photoSrc} 
              alt={item.title} 
              width={650}
              height={650}
              class={`w-full h-full object-cover ${item.photoPos || 'object-center'} ${item.filterClass || ''} group-hover:scale-110 transition-transform duration-500`}
              widths={[380, 640, 960, 1200]}
              sizes="(max-width: 768px) 100vw, (max-width: 1200px) 50vw, 650px"
              quality={60}
              format="webp"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/75 via-transparent to-transparent"></div>
            
            <!-- Hover Magnifier Indicator -->
            <div class="absolute inset-0 bg-epic-blue/30 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center pointer-events-none">
              <div class="w-12 h-12 rounded-full bg-epic-gold text-epic-blue flex items-center justify-center shadow-xl transform group-hover:scale-110 transition-transform">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v6m3-3H7" />
                </svg>
              </div>
            </div>

            <!-- Bottom Details -->
            <div class="absolute bottom-3 left-3 right-3 flex items-center justify-between text-white drop-shadow">
              <span class="font-bold text-xs sm:text-sm truncate mr-2">{item.title}</span>
              <span class="font-mono text-[10px] text-epic-gold opacity-0 group-hover:opacity-100 transition-opacity uppercase tracking-wider flex-shrink-0">Ampliar ↗</span>
            </div>
          </div>
        )
      ))}

      <!-- Expandable Items (Initially hidden in the same grid, smoothly displayed on demand) -->
      {expandedItems.map((item) => (
        item.type === 'video' ? (
          <div 
            class={`${item.defaultSpan} gallery-card gallery-more-item hidden relative rounded-2xl overflow-hidden bg-epic-blue group cursor-pointer shadow-md hover:shadow-2xl transition-all duration-300 border border-epic-blue/10 hover:border-epic-gold/50 focus:outline-none focus:ring-2 focus:ring-epic-gold select-none`}
            data-type="video"
            data-default-span={item.defaultSpan}
            data-video-span={item.videoFilterSpan}
            role="button"
            tabindex="0"
            onclick={`window.openVideoModal('${item.videoUrl}', '${item.title}');`}
            onkeydown={`if(event.key==='Enter'||event.key===' ') { event.preventDefault(); window.openVideoModal('${item.videoUrl}', '${item.title}'); }`}
            aria-label={`Reproducir video: ${item.title}`}
          >
            <img 
              src={item.videoPoster} 
              alt={item.title} 
              width="1200"
              height="675"
              loading="lazy" 
              decoding="async"
              class={`w-full h-full object-cover ${item.filterClass || ''} group-hover:scale-105 transition-transform duration-500`} 
            />
            <div class="absolute inset-0 bg-gradient-to-t from-epic-blue/90 via-black/20 to-black/25"></div>
            
            <!-- Central Gold Play Button without extra labels -->
            <div class="absolute inset-0 m-auto w-14 h-14 sm:w-16 sm:h-16 rounded-full bg-epic-gold text-epic-blue flex items-center justify-center text-2xl transition-all duration-300 transform group-hover:scale-110 shadow-2xl z-20 pointer-events-none group-hover:shadow-epic-gold/40">
              <span class="ml-1">▶</span>
            </div>

            <!-- Bottom Details -->
            <div class="absolute bottom-4 left-4 right-4 text-white z-10 drop-shadow">
              {item.subtitle && (
                <span class="font-mono text-[10px] text-epic-gold uppercase tracking-wider block">{item.subtitle}</span>
              )}
              <h3 class="font-black text-sm sm:text-base leading-snug drop-shadow">{item.title}</h3>
            </div>
          </div>
        ) : (
          <div 
            class={`${item.defaultSpan} gallery-card gallery-more-item hidden relative rounded-2xl overflow-hidden bg-epic-blue group cursor-pointer shadow-md hover:shadow-2xl transition-all duration-300 border border-epic-blue/10 hover:border-epic-gold/40 focus:outline-none focus:ring-2 focus:ring-epic-gold select-none`}
            data-type="photo"
            data-default-span={item.defaultSpan}
            role="button"
            tabindex="0"
            onclick={`window.openImageModal(${item.photoIndex});`}
            onkeydown={`if(event.key==='Enter'||event.key===' ') { event.preventDefault(); window.openImageModal(${item.photoIndex}); }`}
            aria-label={`Ver fotografía ampliada: ${item.title}`}
          >
            <Image 
              src={item.photoSrc} 
              alt={item.title} 
              width={650}
              height={650}
              class={`w-full h-full object-cover ${item.photoPos || 'object-center'} ${item.filterClass || ''} group-hover:scale-110 transition-transform duration-500`}
              widths={[380, 640, 960, 1200]}
              sizes="(max-width: 768px) 100vw, (max-width: 1200px) 50vw, 650px"
              quality={60}
              format="webp"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/75 via-transparent to-transparent"></div>
            
            <!-- Hover Magnifier Indicator -->
            <div class="absolute inset-0 bg-epic-blue/30 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center pointer-events-none">
              <div class="w-12 h-12 rounded-full bg-epic-gold text-epic-blue flex items-center justify-center shadow-xl transform group-hover:scale-110 transition-transform">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v6m3-3H7" />
                </svg>
              </div>
            </div>

            <!-- Bottom Details -->
            <div class="absolute bottom-3 left-3 right-3 flex items-center justify-between text-white drop-shadow">
              <span class="font-bold text-xs sm:text-sm truncate mr-2">{item.title}</span>
              <span class="font-mono text-[10px] text-epic-gold opacity-0 group-hover:opacity-100 transition-opacity uppercase tracking-wider flex-shrink-0">Ampliar ↗</span>
            </div>
          </div>
        )
      ))}

    </div>

    <!-- Toggle Button to View More Content -->
    <div id="toggle-container" class="mt-10 flex justify-center">
      <button 
        id="toggle-gallery-btn"
        type="button" 
        class="group inline-flex items-center gap-3 px-8 py-4 rounded-full border-2 border-epic-blue hover:bg-epic-blue text-epic-blue hover:text-epic-gold font-extrabold text-xs sm:text-sm tracking-wider uppercase transition-all duration-300 shadow-md hover:shadow-xl cursor-pointer"
        aria-expanded="false"
      >
        <span id="toggle-gallery-text">Ver Más Contenido (7 más)</span>
        <span id="toggle-gallery-icon" class="text-base transition-transform duration-300 group-hover:translate-y-0.5">↓</span>
      </button>
    </div>

  </div>
</section>

<script>
  const filterBtns = document.querySelectorAll('.gallery-filter-btn');
  const allCards = document.querySelectorAll('.gallery-card');
  const moreCards = document.querySelectorAll('.gallery-more-item');
  const toggleBtn = document.getElementById('toggle-gallery-btn');
  const toggleContainer = document.getElementById('toggle-container');
  const toggleText = document.getElementById('toggle-gallery-text');
  const toggleIcon = document.getElementById('toggle-gallery-icon');

  let currentFilter = 'all';
  let isExpanded = false;

  function setCardSpans(mode: 'default' | 'video') {
    allCards.forEach(c => {
      const card = c as HTMLElement;
      if (mode === 'video' && card.dataset.videoSpan) {
        if (card.dataset.defaultSpan) {
          card.dataset.defaultSpan.split(' ').forEach(cls => {
            if (cls) card.classList.remove(cls);
          });
        }
        card.dataset.videoSpan.split(' ').forEach(cls => {
          if (cls) card.classList.add(cls);
        });
      } else if (card.dataset.defaultSpan) {
        if (card.dataset.videoSpan) {
          card.dataset.videoSpan.split(' ').forEach(cls => {
            if (cls) card.classList.remove(cls);
          });
        }
        card.dataset.defaultSpan.split(' ').forEach(cls => {
          if (cls) card.classList.add(cls);
        });
      }
    });
  }

  function applyFilter(filter: string) {
    currentFilter = filter;
    filterBtns.forEach(btn => {
      const b = btn as HTMLElement;
      const isActive = b.dataset.filter === filter;
      if (isActive) {
        b.classList.add('bg-epic-blue', 'text-epic-gold', 'border-epic-blue', 'shadow-md');
        b.classList.remove('bg-white', 'text-epic-blue', 'border-epic-blue/20');
      } else {
        b.classList.remove('bg-epic-blue', 'text-epic-gold', 'border-epic-blue', 'shadow-md');
        b.classList.add('bg-white', 'text-epic-blue', 'border-epic-blue/20');
      }
    });

    if (filter === 'video') {
      setCardSpans('video');
      if (toggleContainer) toggleContainer.classList.add('hidden');
      allCards.forEach(c => {
        const card = c as HTMLElement;
        if (card.dataset.type === 'video') {
          card.classList.remove('hidden');
        } else {
          card.classList.add('hidden');
        }
      });
    } else if (filter === 'photo') {
      setCardSpans('default');
      if (toggleContainer) toggleContainer.classList.remove('hidden');
      allCards.forEach(c => {
        const card = c as HTMLElement;
        const isMore = card.classList.contains('gallery-more-item');
        if (card.dataset.type === 'photo') {
          if (isMore) {
            if (isExpanded) {
              card.classList.remove('hidden');
            } else {
              card.classList.add('hidden');
            }
          } else {
            card.classList.remove('hidden');
          }
        } else {
          card.classList.add('hidden');
        }
      });
    } else { // 'all'
      setCardSpans('default');
      if (toggleContainer) toggleContainer.classList.remove('hidden');
      allCards.forEach(c => {
        const card = c as HTMLElement;
        const isMore = card.classList.contains('gallery-more-item');
        if (isMore) {
          if (isExpanded) {
            card.classList.remove('hidden');
          } else {
            card.classList.add('hidden');
          }
        } else {
          card.classList.remove('hidden');
        }
      });
    }
  }

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const target = (btn as HTMLElement).dataset.filter || 'all';
      applyFilter(target);
    });
  });

  if (toggleBtn && toggleText && toggleIcon) {
    toggleBtn.addEventListener('click', () => {
      isExpanded = !isExpanded;
      toggleBtn.setAttribute('aria-expanded', String(isExpanded));

      if (isExpanded) {
        toggleText.textContent = 'Mostrar Menos';
        toggleIcon.textContent = '↑';
        moreCards.forEach(c => {
          const card = c as HTMLElement;
          if (currentFilter === 'all' || card.dataset.type === currentFilter) {
            card.classList.remove('hidden');
          }
        });
      } else {
        toggleText.textContent = 'Ver Más Contenido (7 más)';
        toggleIcon.textContent = '↓';
        moreCards.forEach(c => {
          (c as HTMLElement).classList.add('hidden');
        });

        const gallerySection = document.getElementById('sec-comunidad');
        if (gallerySection) {
          gallerySection.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      }
    });
  }
</script>
