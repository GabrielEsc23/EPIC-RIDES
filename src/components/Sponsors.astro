---
// Sponsors.astro
const sponsors = [
  { name: "700 SETECIENTOS", category: "Apparel & Gear" },
  { name: "AUDAX TRAINING GROUP", category: "High Performance" }
];
---

<section id="sec-sponsors" class="py-16 sm:py-20 bg-epic-gray-bg border-b border-epic-blue/10 scroll-mt-20 overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-12">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      <!-- Social Media (Left 5/12) -->
      <div id="social-block" class="lg:col-span-5 flex flex-col gap-6 opacity-0 translate-y-6 transition-all duration-700 ease-out">
        <div>
          <p class="font-mono text-xs font-bold tracking-[0.2em] text-epic-gold uppercase mb-2">
            COMUNIDAD DIGITAL
          </p>
          <h2 class="font-black text-2xl sm:text-3xl text-epic-blue tracking-tight">
            ÚNETE A NUESTRA FAMILIA CICLISTA
          </h2>
          <div id="social-accent-line" class="h-1 bg-epic-gold rounded-full mt-3 w-0 transition-all duration-700 delay-300"></div>
        </div>

        <p class="text-epic-text-muted text-sm sm:text-base leading-relaxed">
          Comparte rutas, fotos y la pasión por el ciclismo cada día. Conéctate con nosotros en nuestras plataformas oficiales:
        </p>

        <ul class="flex flex-wrap gap-3 pt-2 list-none p-0 m-0">
          <li>
            <a 
              href="https://instagram.com" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="social-btn inline-flex items-center gap-2 px-6 py-3 rounded-full border-2 border-epic-blue hover:bg-epic-blue hover:text-epic-gold text-epic-blue font-extrabold text-xs tracking-wider transition-all uppercase opacity-0 translate-y-3 duration-500 ease-out transform hover:scale-105"
              data-btn-index="0"
            >
              <span>Instagram</span>
            </a>
          </li>
          <li>
            <a 
              href="https://facebook.com" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="social-btn inline-flex items-center gap-2 px-6 py-3 rounded-full border-2 border-epic-blue hover:bg-epic-blue hover:text-epic-gold text-epic-blue font-extrabold text-xs tracking-wider transition-all uppercase opacity-0 translate-y-3 duration-500 ease-out transform hover:scale-105"
              data-btn-index="1"
            >
              <span>Facebook</span>
            </a>
          </li>
          <li>
            <a 
              href="https://tiktok.com" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="social-btn inline-flex items-center gap-2 px-6 py-3 rounded-full border-2 border-epic-blue hover:bg-epic-blue hover:text-epic-gold text-epic-blue font-extrabold text-xs tracking-wider transition-all uppercase opacity-0 translate-y-3 duration-500 ease-out transform hover:scale-105"
              data-btn-index="2"
            >
              <span>TikTok</span>
            </a>
          </li>
        </ul>
      </div>

      <!-- Strategic Sponsors (Right 7/12) -->
      <div id="sponsors-block" class="lg:col-span-7 lg:border-l lg:border-epic-blue/15 lg:pl-12 flex flex-col gap-6 opacity-0 translate-y-6 transition-all duration-700 delay-150 ease-out">
        <div>
          <p class="font-mono text-xs font-bold tracking-[0.2em] text-epic-gold uppercase mb-2">
            PARTNERS DE CONFIANZA
          </p>
          <h2 class="font-black text-2xl sm:text-3xl text-epic-blue tracking-tight">
            ALIANZAS ESTRATÉGICAS PARA TU EXPERIENCIA
          </h2>
          <div id="sponsors-accent-line" class="h-1 bg-epic-gold rounded-full mt-3 w-0 transition-all duration-700 delay-400"></div>
        </div>

        <p class="text-epic-text-muted text-sm sm:text-base leading-relaxed">
          Trabajamos junto a las marcas líderes de la industria ciclista para garantizar soporte técnico de primer nivel, nutrición deportiva e indumentaria en cada kilómetro.
        </p>

        <!-- Brand Badges Grid -->
        <ul class="grid grid-cols-2 sm:grid-cols-3 gap-3 pt-2 list-none p-0 m-0">
          {sponsors.map((s, idx) => (
            <li 
              class="sponsor-card p-4 rounded-xl border border-epic-blue/15 bg-white hover:border-epic-gold shadow-sm hover:shadow-md transition-all text-center group cursor-default opacity-0 translate-y-4 duration-500 ease-out transform hover:scale-105"
              data-sponsor-index={idx}
            >
              <span class="font-mono text-[9px] text-epic-text-muted tracking-widest uppercase block mb-1">{s.category}</span>
              <strong class="font-black text-xs sm:text-sm text-epic-blue group-hover:text-epic-gold transition-colors block">{s.name}</strong>
            </li>
          ))}
        </ul>
      </div>

    </div>
  </div>
</section>

<script>
  const sponsorsSection = document.getElementById('sec-sponsors');
  if (sponsorsSection && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const socialBlock = document.getElementById('social-block');
          const socialAccentLine = document.getElementById('social-accent-line');
          const socialButtons = document.querySelectorAll('.social-btn');
          const sponsorsBlock = document.getElementById('sponsors-block');
          const sponsorsAccentLine = document.getElementById('sponsors-accent-line');
          const sponsorCards = document.querySelectorAll('.sponsor-card');

          if (socialBlock) {
            socialBlock.classList.remove('opacity-0', 'translate-y-6');
            socialBlock.classList.add('opacity-100', 'translate-y-0');
          }
          if (socialAccentLine) {
            socialAccentLine.classList.remove('w-0');
            socialAccentLine.classList.add('w-20');
          }
          socialButtons.forEach((btn, idx) => {
            setTimeout(() => {
              btn.classList.remove('opacity-0', 'translate-y-3');
              btn.classList.add('opacity-100', 'translate-y-0');
            }, 300 + idx * 100);
          });

          if (sponsorsBlock) {
            sponsorsBlock.classList.remove('opacity-0', 'translate-y-6');
            sponsorsBlock.classList.add('opacity-100', 'translate-y-0');
          }
          if (sponsorsAccentLine) {
            sponsorsAccentLine.classList.remove('w-0');
            sponsorsAccentLine.classList.add('w-20');
          }
          sponsorCards.forEach((card, idx) => {
            setTimeout(() => {
              card.classList.remove('opacity-0', 'translate-y-4');
              card.classList.add('opacity-100', 'translate-y-0');
            }, 400 + idx * 120);
          });

          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.15, rootMargin: '0px 0px -40px 0px' });

    observer.observe(sponsorsSection);
  } else {
    // Fallback if no IntersectionObserver
    const socialBlock = document.getElementById('social-block');
    const socialAccentLine = document.getElementById('social-accent-line');
    const socialButtons = document.querySelectorAll('.social-btn');
    const sponsorsBlock = document.getElementById('sponsors-block');
    const sponsorsAccentLine = document.getElementById('sponsors-accent-line');
    const sponsorCards = document.querySelectorAll('.sponsor-card');

    if (socialBlock) socialBlock.classList.remove('opacity-0', 'translate-y-6');
    if (socialAccentLine) socialAccentLine.classList.remove('w-0');
    socialButtons.forEach(btn => btn.classList.remove('opacity-0', 'translate-y-3'));
    if (sponsorsBlock) sponsorsBlock.classList.remove('opacity-0', 'translate-y-6');
    if (sponsorsAccentLine) sponsorsAccentLine.classList.remove('w-0');
    sponsorCards.forEach(card => card.classList.remove('opacity-0', 'translate-y-4'));
  }
</script>
