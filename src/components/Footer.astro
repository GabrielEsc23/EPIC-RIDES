---
// Footer.astro
---

<footer id="sec-footer" class="bg-epic-blue text-white/80 pt-20 pb-12 border-t border-white/10 scroll-mt-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-12">
    
    <!-- Top 4 Columns -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-12 pb-16 border-b border-white/10">
      
      <!-- Brand & Summary (2 cols) -->
      <div class="lg:col-span-2 flex flex-col gap-5">
        <a href="#" class="inline-block focus:outline-none">
          <div class="font-black text-3xl tracking-tighter text-white">
            EPIC<span class="text-epic-gold">RIDES</span>
          </div>
          <span class="font-mono text-[10px] tracking-[0.35em] text-white/50 -mt-1 block">ECUADOR</span>
        </a>
        <p class="text-white/60 text-sm leading-relaxed max-w-sm">
          Transporte especializado de bicicletas de alta gama y expediciones ciclistas inolvidables por los Andes y la Costa de Ecuador. Logística, seguridad y pasión en cada pedalada.
        </p>
        <div class="flex items-center gap-3 pt-2">
          <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse"></span>
          <span class="font-mono text-xs text-white/70">Operaciones activas &bull; Quito, Ecuador</span>
        </div>
      </div>

      <!-- Navigation Links -->
      <div class="flex flex-col gap-3">
        <div class="font-mono text-xs font-black tracking-widest text-epic-gold uppercase mb-2">
          Navegación
        </div>
        <a href="#sec-nosotros" class="text-sm text-white/70 hover:text-epic-gold transition-colors">Sobre Nosotros</a>
        <a href="#sec-servicios" class="text-sm text-white/70 hover:text-epic-gold transition-colors">Paseos Épicos</a>
        <a href="#sec-calendario" class="text-sm text-white/70 hover:text-epic-gold transition-colors">Calendario 2026</a>
        <a href="#sec-transporte" class="text-sm text-white/70 hover:text-epic-gold transition-colors">Transporte Van</a>
      </div>

      <!-- Contact -->
      <div class="flex flex-col gap-3">
        <div class="font-mono text-xs font-black tracking-widest text-epic-gold uppercase mb-2">
          Contacto Directo
        </div>
        <a 
          href="https://wa.me/593999999999?text=Hola%20EPIC%20Rides,%20quisiera%20información%20sobre%20sus%20paseos" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="text-sm text-white/70 hover:text-emerald-400 transition-colors flex items-center gap-2"
        >
          <span>WhatsApp Chat</span>
        </a>
        <a href="mailto:hola@epicrides.ec" class="text-sm text-white/70 hover:text-epic-gold transition-colors">
          hola@epicrides.ec
        </a>
        <p class="text-sm text-white/60">
          Quito &bull; Cumbayá, Ecuador
        </p>
        <p class="text-xs text-white/40 font-mono">
          Horario: Lun – Sáb &bull; 08:00 a 19:00
        </p>
      </div>

      <!-- Legal -->
      <div class="flex flex-col gap-3">
        <div class="font-mono text-xs font-black tracking-widest text-epic-gold uppercase mb-2">
          Legal &amp; Seguridad
        </div>
        <a href="#" class="text-sm text-white/70 hover:text-epic-gold transition-colors">Términos y Condiciones</a>
        <a href="#" class="text-sm text-white/70 hover:text-epic-gold transition-colors">Política de Privacidad</a>
        <a href="#" class="text-sm text-white/70 hover:text-epic-gold transition-colors">Descargo de Responsabilidad</a>
        <a href="#" class="text-sm text-white/70 hover:text-epic-gold transition-colors">Protocolo de Emergencias</a>
      </div>

    </div>

    <!-- Middle Sponsors / Partners Bar -->
    <div class="py-8 border-b border-white/10 flex flex-col md:flex-row items-center justify-between gap-6">
      <div class="font-mono text-[11px] tracking-widest text-white/50 uppercase">
        Patrocinadores Oficiales &amp; Aliados
      </div>
      <div class="flex flex-wrap items-center justify-center gap-6 font-mono text-xs text-white/70 font-bold">
        <span class="hover:text-epic-gold transition-colors">700 SETECIENTOS</span>
        <span class="text-white/20">&bull;</span>
        <span class="hover:text-epic-gold transition-colors">AUDAX GROUP</span>
        <span class="text-white/20">&bull;</span>
        <span class="hover:text-epic-gold transition-colors">SHIMANO SERVICE</span>
        <span class="text-white/20">&bull;</span>
        <span class="hover:text-epic-gold transition-colors">SPECIALIZED</span>
        <span class="text-white/20">&bull;</span>
        <span class="hover:text-epic-gold transition-colors">MAURTEN</span>
      </div>
    </div>

    <!-- Bottom Copyright -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-white/50 font-mono">
      <div>
        &copy; 2026 EPIC Rides Ecuador. Todos los derechos reservados.
      </div>
      <div class="flex items-center gap-4">
        <span>Diseñado para ciclistas apasionados</span>
      </div>
    </div>

  </div>
</footer>
