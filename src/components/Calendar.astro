---
// Calendar.astro
import { Image } from 'astro:assets';
import rutaJul from '../assets/paseos/sigchos-quilotoa.jpg';
import rutaAgo from '../assets/paseos/reto-0-5000-chimborazo.jpg';
import rutaSep from '../assets/paseos/alto-de-apagua.jpg';
import rutaOct from '../assets/paseos/puertos-del-carchi.jpg';
import rutaNov from '../assets/paseos/a-la-playa-en-bici.jpg';
import rutaDic from '../assets/paseos/cierre-de-temporada.jpg';

const events = [
  {
    monthKey: "JUL",
    label: "JULIO",
    dateBadge: "SÁB 11 JUL 2026",
    tag: "RUTA + MTB",
    name: "Sigchos – Quilotoa",
    km: "94 km",
    alt: "+2.400 m",
    level: "Avanzado",
    blurb: " Sigchos – Quilotoa es una experiencia diseñada para descubrir una cara diferente de los Andes ecuatorianos: caminos poco transitados, paisajes que parecen no tener fin y curvas que invitan a perderse para encontrarse con algo extraordinario.La aventura nos lleva por los impresionantes paisajes de Cotopaxi, atravesando Sigchos, conocido como el “Jardín Colgante de los Andes”. Un territorio de relieve quebrado y montañoso, donde los microclimas, la riqueza natural y la grandeza de la cordillera transforman cada kilómetro en una nueva postal.El camino continúa entre curvas de herradura y paisajes imponentes, hasta enfrentarnos a un puerto de montaña que pondrá a prueba nuestras piernas y nuestra determinación.La recompensa final: conquistar la altura y llegar a uno de los paisajes más extraordinarios de Ecuador, la Laguna del Quilotoa.Más que una ruta, es una forma de descubrir Ecuador desde otra perspectiva.Una experiencia para recordar.Una experiencia Epic.",
    image: rutaJul,
    pos: "object-[center_35%]",
    gpx: "/routes/sigchos-quilotoa.gpx"
  },
  {
    monthKey: "AGO",
    label: "AGOSTO",
    dateBadge: "SÁB 15 AGO 2026",
    tag: "RETO INSIGNIA · 2 DÍAS",
    name: "Reto 0 – 5.000m",
    km: "155 km",
    alt: "+5.980 m",
    level: "Élite",
    blurb: "Desde Babahoyo a nivel del mar, superando El Torneado hasta Guaranda (Día 1) y conquistando El Arenal hasta el Refugio del Volcán Chimborazo (Día 2).",
    image: rutaAgo,
    pos: "object-[center_20%]",
    gpx: "/routes/sigchos-quilotoa.gpx"
  },
  {
    monthKey: "SEP",
    label: "SEPTIEMBRE",
    dateBadge: "DOM 13 SEP 2026",
    tag: "4TA SUBIDA MÁS DURA DEL MUNDO",
    name: "Alto de Apagua",
    km: "68 km",
    alt: "+3.800 m",
    level: "Élite",
    blurb: "55 km ininterrumpidos de escalada al 6.5% de promedio. Iniciando en La Maná a 100 msnm y coronando en Apagua a 3.900 msnm con 26.2 FIETS (PJAMM Cycling).",
    image: rutaSep,
    pos: "object-[center_25%]",
    gpx: "/routes/sigchos-quilotoa.gpx"
  },
  {
    monthKey: "OCT",
    label: "OCTUBRE",
    dateBadge: "SÁB 17 OCT 2026",
    tag: "2 DÍAS ÉPICOS",
    name: "Los Puertos del Carchi",
    km: "115 km",
    alt: "+2.700 m",
    level: "Avanzado",
    blurb: "Tierra de campeones. Ascensos míticos por los páramos de frailejones del Carchi, puertos de montaña de alta exigencia y la calidez del ciclismo norteño.",
    image: rutaOct,
    pos: "object-[center_30%]",
    gpx: "/routes/sigchos-quilotoa.gpx"
  },
  {
    monthKey: "NOV",
    label: "NOVIEMBRE",
    dateBadge: "VIE 20 – DOM 22 NOV 2026",
    tag: "3 DÍAS · ANDES A LA COSTA",
    name: "A la Playa en Bici",
    km: "265 km",
    alt: "+2.900 m",
    level: "Avanzado",
    blurb: "Tres etapas inolvidables partiendo de la cordillera andina y descendiendo hasta las playas del Pacífico. Logística integral con furgoneta, hotelería y retorno.",
    image: rutaNov,
    pos: "object-[center_30%]",
    gpx: "/routes/sigchos-quilotoa.gpx"
  },
  {
    monthKey: "DIC",
    label: "DICIEMBRE",
    dateBadge: "FECHA POR CONFIRMAR",
    tag: "EDICIÓN DE CIERRE 2026",
    name: "Cierre Épico de Temporada",
    km: "85 km",
    alt: "+2.100 m",
    level: "Todos los niveles",
    blurb: "Gran fiesta y rodada de fin de año con ruta festiva, brindis en la cima, entrega de reconocimientos de la comunidad EPIC Rides y sorteos oficiales.",
    image: rutaDic,
    pos: "object-[center_40%]",
    gpx: "/routes/sigchos-quilotoa.gpx"
  }
];
---

<section id="sec-calendario" class="py-20 lg:py-28 bg-epic-gray-bg border-b border-epic-blue/10 scroll-mt-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-12">
    
    <!-- Section Title -->
    <div class="max-w-3xl mb-12">
      <h2 class="font-black text-3xl sm:text-5xl lg:text-6xl tracking-tight text-epic-blue leading-tight">
        PRÓXIMAS RODADAS 2026
      </h2>
      <p class="text-epic-text-muted text-base mt-2">
        Elige tu próximo desafío. Cada evento incluye traslado de bicicleta en furgoneta adaptada, hidratación, carro escoba y fotos oficiales.
      </p>
    </div>

    <!-- Monthly Tabs Navigation -->
    <div class="flex overflow-x-auto pb-2 mb-8 border-b-2 border-epic-blue/10 gap-1.5 sm:gap-3 scrollbar-none -mx-4 px-4 sm:mx-0 sm:px-0">
      {events.map((ev, index) => (
        <button 
          type="button"
          class={`calendar-tab shrink-0 md:flex-1 py-2.5 sm:py-4 px-4 sm:px-2 text-center font-extrabold text-xs sm:text-base tracking-wider transition-all duration-200 border-0 border-b-4 -mb-[2px] cursor-pointer outline-none focus:outline-none focus-visible:outline-none focus:ring-0 focus-visible:ring-0 active:outline-none select-none whitespace-nowrap ${index === 0 ? 'border-b-epic-gold text-epic-blue bg-white/70 rounded-t-xl' : 'border-b-transparent text-epic-text-muted hover:text-epic-blue'}`}
          data-tab={index}
        >
          <span class="block font-mono text-[10px] sm:text-xs opacity-60 uppercase">{ev.monthKey}</span>
          <span class="font-bold text-xs sm:text-sm">{ev.label}</span>
        </button>
      ))}
    </div>

    <!-- Event Detail Cards -->
    <div class="relative bg-white rounded-3xl overflow-hidden border border-epic-blue/10 shadow-xl">
      {events.map((ev, index) => (
        <div 
          class={`calendar-event-card grid grid-cols-1 lg:grid-cols-12 transition-all duration-500 ease-in-out ${index === 0 ? 'block' : 'hidden'}`}
          data-event-index={index}
        >
          <!-- Event Image Column (Left 6/12) -->
          <div class="lg:col-span-6 relative min-h-[260px] sm:min-h-[320px] lg:min-h-[460px] bg-epic-blue overflow-hidden">
            <Image 
              src={ev.image} 
              alt={ev.name} 
              class={`w-full h-full object-cover ${ev.pos || 'object-center'}`}
              widths={[360, 480, 640]}
              sizes="(max-width: 768px) 380px, 600px"
              quality={72}
              format="webp"
              loading={index === 0 ? "eager" : "lazy"}
            />
            <div class="absolute inset-0 bg-gradient-to-t from-epic-blue/80 via-transparent to-black/20"></div>
            
            <div class="absolute bottom-4 sm:bottom-6 left-4 sm:left-6 right-4 sm:right-6 flex items-end justify-between">
              <div>
                <span class="inline-block bg-epic-gold text-epic-blue font-mono font-black text-xs px-3 py-1 sm:px-3.5 sm:py-1.5 rounded-full mb-2 uppercase">
                  {ev.dateBadge}
                </span>
                <h3 class="text-white font-black text-xl sm:text-3xl leading-tight">{ev.name}</h3>
              </div>
            </div>
          </div>

          <!-- Event Data Column (Right 6/12) -->
          <div class="lg:col-span-6 p-5 sm:p-10 lg:p-12 flex flex-col justify-between gap-6">
            
            <div>
              <div class="flex flex-wrap items-center gap-2 sm:gap-3 mb-3">
                <span class="font-mono text-xs font-bold tracking-widest text-epic-gold uppercase bg-epic-blue px-3 py-1 rounded-md">
                  {ev.tag}
                </span>
                <span class="text-xs font-mono text-epic-text-muted tracking-wider">
                  CUPO LIMITADO: 14 CICLISTAS
                </span>
              </div>

              <h3 class="font-black text-2xl sm:text-4xl text-epic-blue tracking-tight mb-4">
                {ev.name}
              </h3>

              <!-- Technical Stats -->
              <div class="grid grid-cols-3 gap-2 sm:gap-3 py-4 sm:py-5 border-y border-epic-blue/10 my-4 bg-epic-gray-bg/50 rounded-xl px-3 sm:px-4">
                <div class="min-w-0">
                  <span class="font-mono text-[10px] uppercase tracking-wider text-epic-text-muted block">Distancia</span>
                  <span class="font-black text-lg sm:text-2xl text-epic-blue truncate block">{ev.km}</span>
                </div>
                <div class="min-w-0">
                  <span class="font-mono text-[10px] uppercase tracking-wider text-epic-text-muted block">Altimetría</span>
                  <span class="font-black text-lg sm:text-2xl text-epic-blue truncate block">{ev.alt}</span>
                </div>
                <div class="min-w-0">
                  <span class="font-mono text-[10px] uppercase tracking-wider text-epic-text-muted block">Nivel</span>
                  <span class="font-black text-sm sm:text-2xl text-epic-gold leading-tight break-words block">{ev.level}</span>
                </div>
              </div>

              <p class="text-epic-text-muted text-sm sm:text-base leading-relaxed">
                {ev.blurb}
              </p>
            </div>

            <!-- Action Buttons (Centered Booking Button) -->
            <div class="flex items-center justify-center pt-4">
              <button 
                type="button"
                onclick={`window.openBookingModal('${ev.name}', '${ev.dateBadge}')`}
                class="w-full sm:w-auto bg-epic-blue hover:bg-epic-blue-light text-epic-gold font-extrabold text-xs tracking-wider px-10 py-4 rounded-full text-center transition-all shadow-md uppercase transform hover:scale-105"
              >
                Inscribirme / Reservar Cupo
              </button>
            </div>

          </div>
        </div>
      ))}
    </div>

  </div>
</section>

<script>
  const tabs = document.querySelectorAll('.calendar-tab');
  const cards = document.querySelectorAll('.calendar-event-card');

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      const targetIndex = Number(tab.getAttribute('data-tab'));

      tabs.forEach((t, i) => {
        if (i === targetIndex) {
          t.classList.remove('border-b-transparent', 'text-epic-text-muted');
          t.classList.add('border-b-epic-gold', 'text-epic-blue', 'bg-white/70', 'rounded-t-xl');
          t.scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });
        } else {
          t.classList.remove('border-b-epic-gold', 'text-epic-blue', 'bg-white/70', 'rounded-t-xl');
          t.classList.add('border-b-transparent', 'text-epic-text-muted');
        }
      });

      cards.forEach((c, i) => {
        if (i === targetIndex) {
          c.classList.remove('hidden');
          c.classList.add('block');
        } else {
          c.classList.remove('block');
          c.classList.add('hidden');
        }
      });
    });
  });
</script>

<style>
  .calendar-tab {
    outline: none !important;
    box-shadow: none !important;
    -webkit-tap-highlight-color: transparent;
  }
  .calendar-tab:focus,
  .calendar-tab:focus-visible,
  .calendar-tab:active {
    outline: none !important;
    box-shadow: none !important;
  }
</style>
