---
// Calendar.astro
import { Image, getImage } from 'astro:assets';
import rutaJul from '../assets/paseos/sigchos-quilotoa.jpg';
import rutaAgo from '../assets/paseos/reto-0-5000-chimborazo.jpg';
import rutaSep from '../assets/paseos/alto-de-apagua.jpg';
import rutaOct from '../assets/paseos/puertos-del-carchi.jpg';
import rutaNov from '../assets/../../public/images/PAGINA WEB/PASEOS/A LA PLAYA EN BICI/playa-bici1.jpg';
import rutaDic from '../assets/paseos/cierre-de-temporada.jpg';

// Pre-optimize high-resolution images for the interactive full-screen modal
const optJul = await getImage({ src: rutaJul, width: 1200, format: 'webp', quality: 80 });
const optAgo = await getImage({ src: rutaAgo, width: 1200, format: 'webp', quality: 80 });
const optSep = await getImage({ src: rutaSep, width: 1200, format: 'webp', quality: 80 });
const optOct = await getImage({ src: rutaOct, width: 1200, format: 'webp', quality: 80 });
const optNov = await getImage({ src: rutaNov, width: 1200, format: 'webp', quality: 80 });
const optDic = await getImage({ src: rutaDic, width: 1200, format: 'webp', quality: 80 });

const calendarGallery = [
  {
    src: optJul.src,
    title: "Sigchos – Quilotoa · SÁB 11 JUL 2026",
    desc: "Aventura por el 'Jardín Colgante de los Andes' en Cotopaxi y llegada a la Laguna del Quilotoa. 94 km con +2.400 m de desnivel positivo."
  },
  {
    src: optAgo.src,
    title: "Reto 0 – 5.000m Chimborazo · SÁB 15 AGO 2026",
    desc: "Desde Babahoyo a nivel del mar hasta el Refugio del Volcán Chimborazo. 155 km y +5.980 m de ascenso acumulado en 2 días."
  },
  {
    src: optSep.src,
    title: "Alto de Apagua · DOM 13 SEP 2026",
    desc: "4ta subida más dura del mundo según PJAMM Cycling (26.2 FIETS). 55 km continuos de escalada al 6.5% promedio coronando a 3.900 msnm."
  },
  {
    src: optOct.src,
    title: "Los Puertos del Carchi · SÁB 17 OCT 2026",
    desc: "Tierra de campeones. Ascensos míticos por los páramos de frailejones y puertos de alta montaña en 2 días épicos."
  },
  {
    src: optNov.src,
    title: "A la Playa en Bici · VIE 20 – DOM 22 NOV 2026",
    desc: "Travesía inolvidable de 3 etapas descendiendo desde las cumbres de los Andes hasta las playas del Océano Pacífico."
  },
  {
    src: optDic.src,
    title: "Cierre Épico de Temporada · DIC 2026",
    desc: "Gran rodada y fiesta de fin de año con ruta panorámica, brindis en la cima, entrega de reconocimientos y sorteos oficiales."
  }
];

const events = [
  {
    monthKey: "JUL",
    label: "JULIO",
    dateBadge: "SÁB 11 JUL 2026",
    tag: "RUTA + MTB",
    name: "Sigchos – Quilotoa",
    km: "94 km",
    alt: "+2.400 m",
    level: "Avanzado",
    blurb: `<p class="font-semibold italic text-epic-blue/90">Hay rutas que se recorren. Y hay rutas que se sienten.</p><p><strong>Sigchos – Quilotoa</strong> es una experiencia diseñada para descubrir una cara diferente de los Andes ecuatorianos: caminos poco transitados, paisajes que parecen no tener fin y curvas que invitan a perderse para encontrarse con algo extraordinario.</p><p>La aventura nos lleva por los impresionantes paisajes de Cotopaxi, atravesando <strong>Sigchos, conocido como el “Jardín Colgante de los Andes”</strong>. Un territorio de relieve quebrado y montañoso, donde los microclimas, la riqueza natural y la grandeza de la cordillera transforman cada kilómetro en una nueva postal.</p><p>El camino continúa entre curvas de herradura y paisajes imponentes, hasta enfrentarnos a un puerto de montaña que pondrá a prueba nuestras piernas y nuestra determinación. La recompensa final: conquistar la altura y llegar a uno de los paisajes más extraordinarios de Ecuador, la <strong>Laguna del Quilotoa</strong>.</p>`,
    image: rutaJul,
    pos: "object-[center_80%]",
    gpx: "/routes/sigchos-quilotoa.gpx"
  },
  {
    monthKey: "AGO",
    label: "AGOSTO",
    dateBadge: "SÁB 15 AGO 2026",
    tag: "RETO INSIGNIA · 2 DÍAS",
    name: "Reto 0 – 5.000m",
    km: "155 km",
    alt: "+5.980 m",
    level: "Élite",
    blurb: `<p><strong class="text-epic-blue block mb-1">DÍA 1 · Babahoyo → Guaranda (104 km · 3.500+ m de desnivel)</strong>Partimos desde Babahoyo, a nivel del mar, en un recorrido inicialmente plano con dirección a Balzapamba. Aquí comienza uno de los grandes protagonistas de esta aventura: <strong>El Torneado</strong>, un desafiante puerto de montaña de 20 km y 2.000+ metros de desnivel, que marca la transición de la Costa hacia la Sierra. Una ascensión espectacular que nos lleva por diferentes ecosistemas y pisos climáticos hasta llegar a Guaranda, donde finaliza la primera jornada.</p><p><strong class="text-epic-blue block mb-1">DÍA 2 · Guaranda → Refugio del Chimborazo (51 km · 2.480+ m de desnivel)</strong>La segunda jornada nos lleva desde Guaranda hacia El Arenal, atravesando los paisajes de altura de los Andes hasta alcanzar el gran objetivo de esta experiencia: el <strong>Refugio del Volcán Chimborazo</strong>. Son menos kilómetros, pero cada metro cuenta para conquistar un destino que representa mucho más que una llegada: la recompensa de haber pedaleado desde el nivel del mar hasta uno de los puntos más emblemáticos de Ecuador.</p><p class="font-semibold text-epic-blue"><strong>Dos días. 155 kilómetros. 5.980+ metros de desnivel.</strong> Una experiencia extraordinaria. Un desafío que combina esfuerzo, paisajes y aventura en una de las rutas más espectaculares que puedes vivir sobre una bicicleta.</p>`,
    image: rutaAgo,
    pos: "object-[center_45%]",
    gpx: "/routes/sigchos-quilotoa.gpx"
  },
  {
    monthKey: "SEP",
    label: "SEPTIEMBRE",
    dateBadge: "DOM 13 SEP 2026",
    tag: "4TA SUBIDA MÁS DURA DEL MUNDO",
    name: "Alto de Apagua",
    km: "68 km",
    alt: "+3.800 m",
    level: "Élite",
    blurb: `<p><strong class="text-epic-blue">Considerada la cuarta subida más fuerte del mundo según PJAMM Cycling.</strong><br />Registrada en las páginas internacionales especializadas en ciclismo con <strong>26.2 FIETS</strong> (índice de dureza de una cumbre), esto convierte a Apagua en la 4ta subida más difícil del mundo, con <strong>55 kilómetros ininterrumpidos de escalada a un promedio de 6.5%</strong>. Comparada con el Alto de Letras en Colombia, que tiene 15.4 FIETS, 4% de promedio y está en el puesto 61 de dificultad a nivel mundial.</p><p>Una aventura que conecta la Costa con la Sierra y te lleva a desafiar tus propios límites. El recorrido comienza en <strong>La Maná, a 100 msnm, y asciende hasta Apagua, a 3.900 msnm</strong>. Son 68 kilómetros y más de 3.800 metros de desnivel acumulado, a través de un desafiante puerto de montaña que atraviesa distintos ecosistemas y pisos climáticos, transformando cada kilómetro en una experiencia única.</p><p class="font-semibold text-epic-blue"><strong>Alto de Apagua es mucho más que una ruta.</strong> Es un reto. Una experiencia de altura. Un recorrido que exige preparación, determinación y pasión por la bicicleta. Un desafío que todo ciclista debería vivir al menos una vez.</p>`,
    image: rutaSep,
    pos: "object-[center_36%]",
    gpx: "/routes/sigchos-quilotoa.gpx"
  },
  {
    monthKey: "OCT",
    label: "OCTUBRE",
    dateBadge: "SÁB 17 OCT 2026",
    tag: "2 DÍAS ÉPICOS",
    name: "Los Puertos del Carchi",
    km: "115 km",
    alt: "+2.700 m",
    level: "Avanzado",
    blurb: `<p><strong class="text-epic-blue">Tierra de campeones.</strong> Ascensos míticos por los páramos de frailejones del Carchi, puertos de montaña de alta exigencia y la calidez del ciclismo norteño.</p>`,
    image: rutaOct,
    pos: "object-[center_65%]",
    gpx: "/routes/sigchos-quilotoa.gpx"
  },
  {
    monthKey: "NOV",
    label: "NOVIEMBRE",
    dateBadge: "VIE 20 – DOM 22 NOV 2026",
    tag: "3 DÍAS · ANDES A LA COSTA",
    name: "A la Playa en Bici",
    km: "265 km",
    alt: "+2.900 m",
    level: "Avanzado",
    blurb: `<p><strong class="text-epic-blue">Tres etapas inolvidables</strong> partiendo de la cordillera andina y descendiendo hasta las playas del Pacífico. Logística integral con furgoneta, hotelería y retorno.</p>`,
    image: rutaNov,
    pos: "object-[center_30%]",
    gpx: "/routes/sigchos-quilotoa.gpx"
  },
  {
    monthKey: "DIC",
    label: "DICIEMBRE",
    dateBadge: "FECHA POR CONFIRMAR",
    tag: "EDICIÓN DE CIERRE 2026",
    name: "Cierre Épico de Temporada",
    km: "85 km",
    alt: "+2.100 m",
    level: "Todos los niveles",
    blurb: `<p><strong class="text-epic-blue">Gran fiesta y rodada de fin de año</strong> con ruta festiva, brindis en la cima, entrega de reconocimientos de la comunidad EPIC Rides y sorteos oficiales.</p>`,
    image: rutaDic,
    pos: "object-[center_60%]",
    gpx: "/routes/sigchos-quilotoa.gpx"
  }
];
---

<section id="sec-calendario" class="py-20 lg:py-28 bg-epic-gray-bg border-b border-epic-blue/10 scroll-mt-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-12">
    
    <!-- Section Title -->
    <div class="max-w-3xl mb-12">
      <h2 class="font-black text-3xl sm:text-5xl lg:text-6xl tracking-tight text-epic-blue leading-tight">
        PRÓXIMAS RODADAS 2026
      </h2>
      <p class="text-epic-text-muted text-base mt-2">
        Elige tu próximo desafío. Cada evento incluye traslado de bicicleta en furgoneta adaptada, hidratación, carro escoba y fotos oficiales.
      </p>
    </div>

    <!-- Monthly Tabs Navigation -->
    <div class="flex overflow-x-auto pb-2 mb-8 border-b-2 border-epic-blue/10 gap-1.5 sm:gap-3 scrollbar-none -mx-4 px-4 sm:mx-0 sm:px-0">
      {events.map((ev, index) => (
        <button 
          type="button"
          class={`calendar-tab shrink-0 md:flex-1 py-2.5 sm:py-4 px-4 sm:px-2 text-center font-extrabold text-xs sm:text-base tracking-wider transition-all duration-200 border-0 border-b-4 -mb-[2px] cursor-pointer outline-none focus:outline-none focus-visible:outline-none focus:ring-0 focus-visible:ring-0 active:outline-none select-none whitespace-nowrap ${index === 0 ? 'border-b-epic-gold text-epic-blue bg-white/70 rounded-t-xl' : 'border-b-transparent text-epic-text-muted hover:text-epic-blue'}`}
          data-tab={index}
        >
          <span class="block font-mono text-[10px] sm:text-xs opacity-60 uppercase">{ev.monthKey}</span>
          <span class="font-bold text-xs sm:text-sm">{ev.label}</span>
        </button>
      ))}
    </div>

    <!-- Event Detail Cards (Editorial High-Impact 50/50 Layout) -->
    <div class="relative bg-white rounded-3xl overflow-hidden border border-epic-blue/10 shadow-2xl">
      {events.map((ev, index) => (
        <div 
          class={`calendar-event-card grid grid-cols-1 lg:grid-cols-12 transition-all duration-300 ${index === 0 ? 'grid' : 'hidden'}`}
          data-event-index={index}
        >
          <!-- Full-Bleed Grand Photo Column (Left 6/12) -->
          <div 
            role="button"
            tabindex="0"
            onclick={`window.openCalendarImageModal(${index})`}
            onkeydown={`if(event.key==='Enter'||event.key===' '){event.preventDefault();window.openCalendarImageModal(${index});}`}
            class="lg:col-span-6 relative min-h-[300px] sm:min-h-[380px] lg:min-h-[460px] bg-neutral-900 overflow-hidden group cursor-pointer select-none focus:outline-none focus:ring-2 focus:ring-epic-gold"
            aria-label={`Ver fotografía oficial ampliada de ${ev.name}`}
          >
            <Image 
              src={ev.image} 
              alt={ev.name} 
              class={`w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out ${ev.pos || 'object-center'}`}
              widths={[480, 640, 800]}
              sizes="(max-width: 1024px) 100vw, 50vw"
              quality={75}
              format="webp"
              loading={index === 0 ? "eager" : "lazy"}
            />

            <!-- Top Date Badge -->
            <div class="absolute top-4 left-4 sm:top-6 sm:left-6 z-10">
              <span class="inline-flex items-center bg-epic-gold text-epic-blue font-mono font-black text-xs sm:text-sm px-3.5 py-1.5 rounded-full uppercase shadow-lg">
                {ev.dateBadge}
              </span>
            </div>

            <!-- Subtle Magnifier on Hover Only (Hidden by default, gentle opacity on hover) -->
            <div class="absolute inset-0 flex items-center justify-center p-4 opacity-0 group-hover:opacity-75 transition-opacity duration-300 pointer-events-none z-10">
              <div class="w-12 h-12 rounded-full bg-black/50 backdrop-blur-sm border border-white/20 text-white flex items-center justify-center shadow-lg transform group-hover:scale-105 transition-transform">
                <svg class="w-5 h-5 text-epic-gold" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v6m3-3H7" />
                </svg>
              </div>
            </div>
          </div>

          <!-- Event Data Column (Right 6/12) -->
          <div class="lg:col-span-6 p-6 sm:p-8 lg:p-10 flex flex-col justify-between gap-6">
            <div>
              <div class="flex flex-wrap items-center gap-2 sm:gap-3 mb-3">
                <span class="font-mono text-xs font-bold tracking-widest text-epic-gold uppercase bg-epic-blue px-3 py-1 rounded-md">
                  {ev.tag}
                </span>
                <span class="text-xs font-mono text-epic-text-muted tracking-wider">
                  CUPO LIMITADO: 14 CICLISTAS
                </span>
              </div>

              <h3 class="font-black text-2xl sm:text-3xl lg:text-4xl text-epic-blue tracking-tight mb-4">
                {ev.name}
              </h3>

              <!-- Technical Stats -->
              <div class="grid grid-cols-3 gap-2 sm:gap-3 py-4 border-y border-epic-blue/10 my-4 bg-epic-gray-bg/50 rounded-xl px-3 sm:px-4">
                <div class="min-w-0">
                  <span class="font-mono text-[10px] uppercase tracking-wider text-epic-text-muted block">Distancia</span>
                  <span class="font-black text-lg sm:text-2xl text-epic-blue truncate block">{ev.km}</span>
                </div>
                <div class="min-w-0">
                  <span class="font-mono text-[10px] uppercase tracking-wider text-epic-text-muted block">Altimetría</span>
                  <span class="font-black text-lg sm:text-2xl text-epic-blue truncate block">{ev.alt}</span>
                </div>
                <div class="min-w-0">
                  <span class="font-mono text-[10px] uppercase tracking-wider text-epic-text-muted block">Nivel</span>
                  <span class="font-black text-sm sm:text-xl text-epic-gold leading-tight break-words block">{ev.level}</span>
                </div>
              </div>

              <!-- Scannable and Accessible Route Description (WCAG & UX Typography Rules) -->
              <div class="text-epic-text-muted text-sm sm:text-[15px] leading-relaxed max-w-[65ch] space-y-2.5 text-left font-normal">
                <Fragment set:html={ev.blurb} />
              </div>
            </div>

            <!-- Action Buttons (Clean Centered Booking CTA) -->
            <div class="flex items-center justify-center pt-2">
              <button 
                type="button"
                onclick={`window.openBookingModal('${ev.name}', '${ev.dateBadge}')`}
                class="w-full sm:w-auto bg-epic-blue hover:bg-epic-blue-light text-epic-gold font-extrabold text-xs tracking-wider px-10 py-4 rounded-full text-center transition-all shadow-md uppercase transform hover:scale-105 cursor-pointer"
              >
                Inscribirme / Reservar Cupo
              </button>
            </div>

          </div>
        </div>
      ))}
    </div>

  </div>
</section>

<script define:vars={{ calendarGallery }}>
  // Expose calendar gallery globally for Modals lightbox
  window.calendarRoutesGallery = calendarGallery;

  const tabs = document.querySelectorAll('.calendar-tab');
  const cards = document.querySelectorAll('.calendar-event-card');

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      const targetIndex = Number(tab.getAttribute('data-tab'));

      tabs.forEach((t, i) => {
        if (i === targetIndex) {
          t.classList.remove('border-b-transparent', 'text-epic-text-muted');
          t.classList.add('border-b-epic-gold', 'text-epic-blue', 'bg-white/70', 'rounded-t-xl');
          t.scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });
        } else {
          t.classList.remove('border-b-epic-gold', 'text-epic-blue', 'bg-white/70', 'rounded-t-xl');
          t.classList.add('border-b-transparent', 'text-epic-text-muted');
        }
      });

      cards.forEach((c, i) => {
        if (i === targetIndex) {
          c.classList.remove('hidden');
          c.classList.add('grid');
        } else {
          c.classList.remove('grid');
          c.classList.add('hidden');
        }
      });
    });
  });
</script>

<style>
  .calendar-tab {
    outline: none !important;
    box-shadow: none !important;
    -webkit-tap-highlight-color: transparent;
  }
  .calendar-tab:focus,
  .calendar-tab:focus-visible,
  .calendar-tab:active {
    outline: none !important;
    box-shadow: none !important;
  }
</style>
