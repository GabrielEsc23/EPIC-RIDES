---
// Calendar.astro
import { Image, getImage } from 'astro:assets';
import rutaJul from '../assets/paseos/sigchos-quilotoa.jpg';
import rutaAgo from '../assets/paseos/reto-0-5000-chimborazo.jpg';
import rutaSep from '../assets/paseos/alto-de-apagua.jpg';
import rutaOct from '../assets/paseos/puertos-del-carchi.jpg';
import rutaNov from '../assets/../../public/images/PAGINA WEB/PASEOS/A LA PLAYA EN BICI/playa-bici1.jpg';
import rutaDic from '../assets/paseos/cierre-de-temporada.jpg';

// Pre-optimize high-resolution images for the interactive full-screen modal
const optJul = await getImage({ src: rutaJul, width: 1200, format: 'webp', quality: 80 });
const optAgo = await getImage({ src: rutaAgo, width: 1200, format: 'webp', quality: 80 });
const optSep = await getImage({ src: rutaSep, width: 1200, format: 'webp', quality: 80 });
const optOct = await getImage({ src: rutaOct, width: 1200, format: 'webp', quality: 80 });
const optNov = await getImage({ src: rutaNov, width: 1200, format: 'webp', quality: 80 });
const optDic = await getImage({ src: rutaDic, width: 1200, format: 'webp', quality: 80 });

const calendarGallery = [
  {
    src: optJul.src,
    title: "Sigchos – Quilotoa · SÁB 11 JUL 2026",
    desc: "Aventura por el 'Jardín Colgante de los Andes' en Cotopaxi y llegada a la Laguna del Quilotoa. 94 km con +2.400 m de desnivel positivo."
  },
  {
    src: optAgo.src,
    title: "Reto 0 – 5.000m Chimborazo · SÁB 15 AGO 2026",
    desc: "Desde Babahoyo a nivel del mar hasta el Refugio del Volcán Chimborazo. 155 km y +5.980 m de ascenso acumulado en 2 días."
  },
  {
    src: optSep.src,
    title: "Alto de Apagua · DOM 13 SEP 2026",
    desc: "4ta subida más dura del mundo según PJAMM Cycling (26.2 FIETS). 55 km continuos de escalada al 6.5% promedio coronando a 3.900 msnm."
  },
  {
    src: optOct.src,
    title: "Los Puertos del Carchi · SÁB 17 OCT 2026",
    desc: "Tierra de campeones. Ascensos míticos por los páramos de frailejones y puertos de alta montaña en 2 días épicos."
  },
  {
    src: optNov.src,
    title: "A la Playa en Bici · VIE 20 – DOM 22 NOV 2026",
    desc: "Travesía inolvidable de 3 etapas descendiendo desde las cumbres de los Andes hasta las playas del Océano Pacífico."
  },
  {
    src: optDic.src,
    title: "Cierre Épico de Temporada · DIC 2026",
    desc: "Gran rodada y fiesta de fin de año con ruta panorámica, brindis en la cima, entrega de reconocimientos y sorteos oficiales."
  }
];

const events = [
  {
    monthKey: "JUL",
    label: "JULIO",
    dateBadge: "SÁB 11 JUL 2026",
    tag: "RUTA + MTB",
    name: "Sigchos – Quilotoa",
    km: "94 km",
    alt: "+2.400 m",
    level: "Avanzado",
    blurb: "Aventura diseñada para descubrir los Andes de Cotopaxi por el 'Jardín Colgante de los Andes'. Curvas de herradura, puertos de alta montaña y llegada triunfal a la majestuosa Laguna del Quilotoa.",
    image: rutaJul,
    pos: "object-[center_80%]",
    gpx: "/routes/sigchos-quilotoa.gpx"
  },
  {
    monthKey: "AGO",
    label: "AGOSTO",
    dateBadge: "SÁB 15 AGO 2026",
    tag: "RETO INSIGNIA · 2 DÍAS",
    name: "Reto 0 – 5.000m",
    km: "155 km",
    alt: "+5.980 m",
    level: "Élite",
    blurb: "Desde Babahoyo a nivel del mar, superando El Torneado hasta Guaranda (Día 1) y conquistando El Arenal hasta el Refugio del Volcán Chimborazo (Día 2).",
    image: rutaAgo,
    pos: "object-[center_45%]",
    gpx: "/routes/sigchos-quilotoa.gpx"
  },
  {
    monthKey: "SEP",
    label: "SEPTIEMBRE",
    dateBadge: "DOM 13 SEP 2026",
    tag: "4TA SUBIDA MÁS DURA DEL MUNDO",
    name: "Alto de Apagua",
    km: "68 km",
    alt: "+3.800 m",
    level: "Élite",
    blurb: "55 km ininterrumpidos de escalada al 6.5% de promedio. Iniciando en La Maná a 100 msnm y coronando en Apagua a 3.900 msnm con 26.2 FIETS (PJAMM Cycling).",
    image: rutaSep,
    pos: "object-[center_36%]",
    gpx: "/routes/sigchos-quilotoa.gpx"
  },
  {
    monthKey: "OCT",
    label: "OCTUBRE",
    dateBadge: "SÁB 17 OCT 2026",
    tag: "2 DÍAS ÉPICOS",
    name: "Los Puertos del Carchi",
    km: "115 km",
    alt: "+2.700 m",
    level: "Avanzado",
    blurb: "Tierra de campeones. Ascensos míticos por los páramos de frailejones del Carchi, puertos de montaña de alta exigencia y la calidez del ciclismo norteño.",
    image: rutaOct,
    pos: "object-[center_65%]",
    gpx: "/routes/sigchos-quilotoa.gpx"
  },
  {
    monthKey: "NOV",
    label: "NOVIEMBRE",
    dateBadge: "VIE 20 – DOM 22 NOV 2026",
    tag: "3 DÍAS · ANDES A LA COSTA",
    name: "A la Playa en Bici",
    km: "265 km",
    alt: "+2.900 m",
    level: "Avanzado",
    blurb: "Tres etapas inolvidables partiendo de la cordillera andina y descendiendo hasta las playas del Pacífico. Logística integral con furgoneta, hotelería y retorno.",
    image: rutaNov,
    pos: "object-[center_30%]",
    gpx: "/routes/sigchos-quilotoa.gpx"
  },
  {
    monthKey: "DIC",
    label: "DICIEMBRE",
    dateBadge: "FECHA POR CONFIRMAR",
    tag: "EDICIÓN DE CIERRE 2026",
    name: "Cierre Épico de Temporada",
    km: "85 km",
    alt: "+2.100 m",
    level: "Todos los niveles",
    blurb: "Gran fiesta y rodada de fin de año con ruta festiva, brindis en la cima, entrega de reconocimientos de la comunidad EPIC Rides y sorteos oficiales.",
    image: rutaDic,
    pos: "object-[center_60%]",
    gpx: "/routes/sigchos-quilotoa.gpx"
  }
];
---

<section id="sec-calendario" class="py-20 lg:py-28 bg-epic-gray-bg border-b border-epic-blue/10 scroll-mt-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-12">
    
    <!-- Section Title -->
    <div class="max-w-3xl mb-12">
      <h2 class="font-black text-3xl sm:text-5xl lg:text-6xl tracking-tight text-epic-blue leading-tight">
        PRÓXIMAS RODADAS 2026
      </h2>
      <p class="text-epic-text-muted text-base mt-2">
        Elige tu próximo desafío. Cada evento incluye traslado de bicicleta en furgoneta adaptada, hidratación, carro escoba y fotos oficiales.
      </p>
    </div>

    <!-- Monthly Tabs Navigation -->
    <div class="flex overflow-x-auto pb-2 mb-8 border-b-2 border-epic-blue/10 gap-1.5 sm:gap-3 scrollbar-none -mx-4 px-4 sm:mx-0 sm:px-0">
      {events.map((ev, index) => (
        <button 
          type="button"
          class={`calendar-tab shrink-0 md:flex-1 py-2.5 sm:py-4 px-4 sm:px-2 text-center font-extrabold text-xs sm:text-base tracking-wider transition-all duration-200 border-0 border-b-4 -mb-[2px] cursor-pointer outline-none focus:outline-none focus-visible:outline-none focus:ring-0 focus-visible:ring-0 active:outline-none select-none whitespace-nowrap ${index === 0 ? 'border-b-epic-gold text-epic-blue bg-white/70 rounded-t-xl' : 'border-b-transparent text-epic-text-muted hover:text-epic-blue'}`}
          data-tab={index}
        >
          <span class="block font-mono text-[10px] sm:text-xs opacity-60 uppercase">{ev.monthKey}</span>
          <span class="font-bold text-xs sm:text-sm">{ev.label}</span>
        </button>
      ))}
    </div>

    <!-- Event Detail Cards (Compact & Balanced Height) -->
    <div class="relative bg-white rounded-3xl overflow-hidden border border-epic-blue/10 shadow-xl p-4 sm:p-6 lg:p-7">
      {events.map((ev, index) => (
        <div 
          class={`calendar-event-card grid grid-cols-1 lg:grid-cols-12 gap-5 lg:gap-8 items-center transition-all duration-300 ${index === 0 ? 'grid' : 'hidden'}`}
          data-event-index={index}
        >
          <!-- Compact Photo Preview Column (Left 5/12) -->
          <div class="lg:col-span-5">
            <div 
              role="button"
              tabindex="0"
              onclick={`window.openCalendarImageModal(${index})`}
              onkeydown={`if(event.key==='Enter'||event.key===' '){event.preventDefault();window.openCalendarImageModal(${index});}`}
              class="relative w-full h-48 sm:h-56 lg:h-64 rounded-2xl overflow-hidden group cursor-pointer shadow-md border border-epic-blue/15 bg-epic-blue focus:outline-none focus:ring-2 focus:ring-epic-gold"
              aria-label={`Ver foto completa de la rodada ${ev.name}`}
            >
              <Image 
                src={ev.image} 
                alt={ev.name} 
                class={`w-full h-full object-cover ${ev.pos || 'object-center'} group-hover:scale-105 transition-transform duration-500`}
                widths={[320, 480]}
                sizes="(max-width: 768px) 340px, 460px"
                quality={72}
                format="webp"
                loading={index === 0 ? "eager" : "lazy"}
              />
              <div class="absolute inset-0 bg-gradient-to-t from-epic-blue/85 via-black/20 to-transparent group-hover:from-epic-blue/90 transition-colors"></div>
              
              <!-- Top Date Badge -->
              <div class="absolute top-3 left-3">
                <span class="inline-flex items-center bg-epic-gold text-epic-blue font-mono font-black text-[11px] sm:text-xs px-3 py-1 rounded-full uppercase shadow-md">
                  {ev.dateBadge}
                </span>
              </div>

              <!-- Center Magnifier Pill on Hover / Mobile Indicator -->
              <div class="absolute inset-0 flex items-center justify-center p-3">
                <span class="inline-flex items-center gap-1.5 bg-black/65 group-hover:bg-epic-gold group-hover:text-epic-blue text-white backdrop-blur-md font-bold text-xs sm:text-sm px-4 py-2 rounded-full border border-white/20 group-hover:border-epic-gold shadow-xl transition-all transform group-hover:scale-105 select-none">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v6m3-3H7" />
                  </svg>
                  <span>Ver foto completa</span>
                </span>
              </div>

              <!-- Bottom Bar Info inside Preview -->
              <div class="absolute bottom-2.5 left-3.5 right-3.5 flex items-center justify-between text-[11px] font-mono text-white/90">
                <span class="truncate font-bold drop-shadow">{ev.name}</span>
                <span class="text-epic-gold drop-shadow flex-shrink-0 font-bold ml-2">Click para ampliar ↗</span>
              </div>
            </div>
          </div>

          <!-- Event Data Column (Right 7/12) -->
          <div class="lg:col-span-7 flex flex-col justify-between py-1">
            <div>
              <div class="flex flex-wrap items-center gap-2 mb-2">
                <span class="font-mono text-[11px] font-bold tracking-widest text-epic-gold uppercase bg-epic-blue px-2.5 py-0.5 rounded-md">
                  {ev.tag}
                </span>
                <span class="text-[11px] font-mono text-epic-text-muted tracking-wider">
                  CUPO LIMITADO: 14 CICLISTAS
                </span>
              </div>

              <h3 class="font-black text-2xl sm:text-3xl text-epic-blue tracking-tight mb-2">
                {ev.name}
              </h3>

              <!-- Technical Stats -->
              <div class="grid grid-cols-3 gap-2 py-2.5 sm:py-3 border-y border-epic-blue/10 my-2.5 sm:my-3 bg-epic-gray-bg/50 rounded-xl px-3 sm:px-4">
                <div class="min-w-0">
                  <span class="font-mono text-[10px] uppercase tracking-wider text-epic-text-muted block">Distancia</span>
                  <span class="font-black text-base sm:text-xl text-epic-blue truncate block">{ev.km}</span>
                </div>
                <div class="min-w-0">
                  <span class="font-mono text-[10px] uppercase tracking-wider text-epic-text-muted block">Altimetría</span>
                  <span class="font-black text-base sm:text-xl text-epic-blue truncate block">{ev.alt}</span>
                </div>
                <div class="min-w-0">
                  <span class="font-mono text-[10px] uppercase tracking-wider text-epic-text-muted block">Nivel</span>
                  <span class="font-black text-xs sm:text-base text-epic-gold leading-tight break-words block">{ev.level}</span>
                </div>
              </div>

              <p class="text-epic-text-muted text-xs sm:text-sm leading-relaxed mb-4">
                {ev.blurb}
              </p>
            </div>

            <!-- Action Buttons: Booking CTA + Expand Photo Button -->
            <div class="flex flex-wrap items-center gap-3 pt-1">
              <button 
                type="button"
                onclick={`window.openBookingModal('${ev.name}', '${ev.dateBadge}')`}
                class="w-full sm:w-auto bg-epic-blue hover:bg-epic-blue-light text-epic-gold font-extrabold text-xs tracking-wider px-8 py-3.5 rounded-full text-center transition-all shadow-md uppercase transform hover:scale-105 cursor-pointer"
              >
                Inscribirme / Reservar Cupo
              </button>

              <button 
                type="button"
                onclick={`window.openCalendarImageModal(${index})`}
                class="w-full sm:w-auto text-epic-blue hover:text-epic-blue-light font-bold text-xs inline-flex items-center justify-center gap-1.5 py-3 px-4 rounded-full border border-epic-blue/20 hover:border-epic-gold hover:bg-epic-gold/10 transition-all cursor-pointer"
              >
                <svg class="w-3.5 h-3.5 text-epic-gold" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v6m3-3H7" />
                </svg>
                <span>Ver foto completa</span>
              </button>
            </div>

          </div>
        </div>
      ))}
    </div>

  </div>
</section>

<script define:vars={{ calendarGallery }}>
  // Expose calendar gallery globally for Modals lightbox
  window.calendarRoutesGallery = calendarGallery;

  const tabs = document.querySelectorAll('.calendar-tab');
  const cards = document.querySelectorAll('.calendar-event-card');

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      const targetIndex = Number(tab.getAttribute('data-tab'));

      tabs.forEach((t, i) => {
        if (i === targetIndex) {
          t.classList.remove('border-b-transparent', 'text-epic-text-muted');
          t.classList.add('border-b-epic-gold', 'text-epic-blue', 'bg-white/70', 'rounded-t-xl');
          t.scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });
        } else {
          t.classList.remove('border-b-epic-gold', 'text-epic-blue', 'bg-white/70', 'rounded-t-xl');
          t.classList.add('border-b-transparent', 'text-epic-text-muted');
        }
      });

      cards.forEach((c, i) => {
        if (i === targetIndex) {
          c.classList.remove('hidden');
          c.classList.add('grid');
        } else {
          c.classList.remove('grid');
          c.classList.add('hidden');
        }
      });
    });
  });
</script>

<style>
  .calendar-tab {
    outline: none !important;
    box-shadow: none !important;
    -webkit-tap-highlight-color: transparent;
  }
  .calendar-tab:focus,
  .calendar-tab:focus-visible,
  .calendar-tab:active {
    outline: none !important;
    box-shadow: none !important;
  }
</style>
