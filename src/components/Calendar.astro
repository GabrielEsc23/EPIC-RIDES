---
// Calendar.astro
import { Image, getImage } from 'astro:assets';

// Sigchos - Quilotoa
import sigchos1 from '../assets/paseos/sigchos-1.jpg';
import sigchos2 from '../assets/paseos/sigchos-2.jpg';
import sigchos3 from '../assets/paseos/sigchos-3.jpg';
import sigchos4 from '../assets/paseos/sigchos-4.jpg';

// Chimborazo (0 a 5000)
import chimborazo1 from '../assets/paseos/chimborazo-1.jpg';
import chimborazo2 from '../assets/paseos/chimborazo-2.jpg';
import chimborazo3 from '../assets/paseos/chimborazo-3.jpg';
import chimborazo4 from '../assets/paseos/chimborazo-4.jpg';

// Alto de Apagua
import apagua1 from '../assets/paseos/apagua-1.jpg';
import apagua2 from '../assets/paseos/apagua-2.jpg';
import apagua3 from '../assets/paseos/apagua-3.jpg';
import apagua4 from '../assets/paseos/apagua-4.jpg';

// Los Puertos del Carchi
import carchi1 from '../assets/paseos/carchi-1.jpg';
import carchi2 from '../assets/paseos/carchi-2.jpg';
import carchi3 from '../assets/paseos/carchi-3.jpg';
import carchi4 from '../assets/paseos/carchi-4.jpg';

// A la Playa en Bici
import playa1 from '../assets/paseos/playa-1.jpg';
import playa2 from '../assets/paseos/playa-2.jpg';
import playa3 from '../assets/paseos/playa-3.jpg';
import playa4 from '../assets/paseos/playa-4.jpg';
import playa5 from '../assets/paseos/playa-5.jpg';

// Quisapincha
import quisapincha1 from '../assets/paseos/quisapincha-1.jpg';
import quisapincha2 from '../assets/paseos/quisapincha-2.jpg';
import quisapincha3 from '../assets/paseos/quisapincha-3.jpg';

// Pre-optimize high-resolution images for the interactive full-screen modal
const optJul = await getImage({ src: sigchos1, width: 1200, format: 'webp', quality: 70 });
const optAgo = await getImage({ src: chimborazo1, width: 1200, format: 'webp', quality: 70 });
const optSep = await getImage({ src: apagua1, width: 1200, format: 'webp', quality: 70 });
const optOct = await getImage({ src: carchi1, width: 1200, format: 'webp', quality: 70 });
const optNov = await getImage({ src: playa1, width: 1200, format: 'webp', quality: 70 });
const optDic = await getImage({ src: quisapincha1, width: 1200, format: 'webp', quality: 70 });

const calendarGallery = [
  {
    src: optJul.src,
    title: "Sigchos – Quilotoa",
    desc: "Aventura por el 'Jardín Colgante de los Andes' en Cotopaxi y llegada a la Laguna del Quilotoa. 94 km con +2.400 m de desnivel positivo."
  },
  {
    src: optAgo.src,
    title: "Reto 0 – 5.000m Chimborazo",
    desc: "Desde Babahoyo a nivel del mar hasta el Refugio del Volcán Chimborazo. 155 km y +5.980 m de ascenso acumulado en 2 días."
  },
  {
    src: optSep.src,
    title: "Alto de Apagua",
    desc: "4ta subida más dura del mundo según PJAMM Cycling (26.2 FIETS). 55 km continuos de escalada al 6.5% promedio coronando a 3.900 msnm."
  },
  {
    src: optOct.src,
    title: "Los Puertos del Carchi",
    desc: "Una tierra. Cuatro puertos: El Juncal, Guagua Negro, La Estrellita y El Troje hasta La Casa de Richard Carapaz. 160K y +3.670 m de desnivel."
  },
  {
    src: optNov.src,
    title: "A la Playa en Bici",
    desc: "Travesía inolvidable de 2 días desde Quito descendiendo hacia Pedernales hasta llegar al mar. 280 km y +3.300 m de desnivel."
  },
  {
    src: optDic.src,
    title: "Quisapincha",
    desc: "Desde Quito pasando por el Chasqui, Latacunga y Ambato hasta la subida emblemática a Quisapincha. 150 km y +2.400 m de desnivel."
  }
];

const events = [
  {
    monthKey: "JUL",
    label: "JULIO",
    dateBadge: "SÁB 11 JUL 2026",
    tag: "RUTA + MTB",
    name: "Sigchos – Quilotoa",
    km: "94 km",
    alt: "+2.400 m",
    level: "Avanzado",
    blurb: `<p class="font-semibold italic text-epic-blue/90">Hay rutas que se recorren. Y hay rutas que se sienten.</p><p><strong>Sigchos – Quilotoa</strong> es una experiencia diseñada para descubrir una cara diferente de los Andes ecuatorianos: caminos poco transitados, paisajes que parecen no tener fin y curvas que invitan a perderse para encontrarse con algo extraordinario.</p><p>La aventura nos lleva por los impresionantes paisajes de Cotopaxi, atravesando <strong>Sigchos, conocido como el “Jardín Colgante de los Andes”</strong>. Un territorio de relieve quebrado y montañoso, donde los microclimas, la riqueza natural y la grandeza de la cordillera transforman cada kilómetro en una nueva postal.</p><p>El camino continúa entre curvas de herradura y paisajes imponentes, hasta enfrentarnos a un puerto de montaña que pondrá a prueba nuestras piernas y nuestra determinación. La recompensa final: conquistar la altura y llegar a uno de los paisajes más extraordinarios de Ecuador, la <strong>Laguna del Quilotoa</strong>.</p>`,
    images: [sigchos1, sigchos2, sigchos3, sigchos4],
    pos: "object-[center_80%]",
    gpx: "/routes/sigchos-quilotoa.gpx"
  },
  {
    monthKey: "AGO",
    label: "AGOSTO",
    dateBadge: "SÁB 15 AGO 2026",
    tag: "RETO INSIGNIA · 2 DÍAS",
    name: "Reto 0 – 5.000m",
    km: "155 km",
    alt: "+5.980 m",
    level: "Élite",
    blurb: `<p><strong class="text-epic-blue block mb-1">DÍA 1 · Babahoyo → Guaranda (104 km · 3.500+ m de desnivel)</strong>Partimos desde Babahoyo, a nivel del mar, en un recorrido inicialmente plano con dirección a Balzapamba. Aquí comienza uno de los grandes protagonistas de esta aventura: <strong>El Torneado</strong>, un desafiante puerto de montaña de 20 km y 2.000+ metros de desnivel, que marca la transición de la Costa hacia la Sierra. Una ascensión espectacular que nos lleva por diferentes ecosistemas y pisos climáticos hasta llegar a Guaranda, donde finaliza la primera jornada.</p><p><strong class="text-epic-blue block mb-1">DÍA 2 · Guaranda → Refugio del Chimborazo (51 km · 2.480+ m de desnivel)</strong>La segunda jornada nos lleva desde Guaranda hacia El Arenal, atravesando los paisajes de altura de los Andes hasta alcanzar el gran objetivo de esta experiencia: el <strong>Refugio del Volcán Chimborazo</strong>. Son menos kilómetros, pero cada metro cuenta para conquistar un destino que representa mucho más que una llegada: la recompensa de haber pedaleado desde el nivel del mar hasta uno de los puntos más emblemáticos de Ecuador.</p><p class="font-semibold text-epic-blue"><strong>Dos días. 155 kilómetros. 5.980+ metros de desnivel.</strong> Una experiencia extraordinaria. Un desafío que combina esfuerzo, paisajes y aventura en una de las rutas más espectaculares que puedes vivir sobre una bicicleta.</p>`,
    images: [chimborazo1, chimborazo2, chimborazo3, chimborazo4],
    pos: "object-[center_45%]",
    gpx: "/routes/sigchos-quilotoa.gpx"
  },
  {
    monthKey: "SEP",
    label: "SEPTIEMBRE",
    dateBadge: "DOM 13 SEP 2026",
    tag: "4TA SUBIDA MÁS DURA DEL MUNDO",
    name: "Alto de Apagua",
    km: "68 km",
    alt: "+3.800 m",
    level: "Élite",
    blurb: `<p><strong class="text-epic-blue">Considerada la cuarta subida más fuerte del mundo según PJAMM Cycling.</strong><br />Registrada en las páginas internacionales especializadas en ciclismo con <strong>26.2 FIETS</strong> (índice de dureza de una cumbre), esto convierte a Apagua en la 4ta subida más difícil del mundo, con <strong>55 kilómetros ininterrumpidos de escalada a un promedio de 6.5%</strong>. Comparada con el Alto de Letras en Colombia, que tiene 15.4 FIETS, 4% de promedio y está en el puesto 61 de dificultad a nivel mundial.</p><p>Una aventura que conecta la Costa con la Sierra y te lleva a desafiar tus propios límites. El recorrido comienza en <strong>La Maná, a 100 msnm, y asciende hasta Apagua, a 3.900 msnm</strong>. Son 68 kilómetros y más de 3.800 metros de desnivel acumulado, a través de un desafiante puerto de montaña que atraviesa distintos ecosistemas y pisos climáticos, transformando cada kilómetro en una experiencia única.</p><p class="font-semibold text-epic-blue"><strong>Alto de Apagua es mucho más que una ruta.</strong> Es un reto. Una experiencia de altura. Un recorrido que exige preparación, determinación y pasión por la bicicleta. Un desafío que todo ciclista debería vivir al menos una vez.</p>`,
    images: [apagua1, apagua2, apagua3, apagua4],
    pos: "object-[center_36%]",
    gpx: "/routes/sigchos-quilotoa.gpx"
  },
  {
    monthKey: "OCT",
    label: "OCTUBRE",
    dateBadge: "SÁB 17 OCT 2026",
    tag: "2 DÍAS ÉPICOS",
    name: "Los Puertos del Carchi",
    km: "160 km",
    alt: "+3.670 m",
    level: "Medio – Avanzado",
    blurb: `<p class="font-semibold italic text-epic-blue/90">Una tierra. Cuatro puertos. Una experiencia que queda.</p><p>Pedalea por los caminos que han visto crecer a grandes leyendas del ciclismo ecuatoriano. Durante dos días conquistaremos <strong>El Juncal, Guagua Negro, La Estrellita y El Troje</strong>, recorriendo paisajes que combinan montaña, naturaleza y la esencia más auténtica del Carchi.</p><p><strong>160K de ruta · +3.670 m de desnivel.</strong> Dos días para desafiarte, disfrutar el camino y vivir el ciclismo en su máxima expresión.</p><p>El recorrido culmina en <strong>La Casa de Richard Carapaz</strong>, cerrando una experiencia que conecta territorio, historia y pasión por la bicicleta.</p><p class="font-semibold text-epic-blue">DOS DÍAS. CUATRO PUERTOS. UNA EXPERIENCIA ÉPICA.</p>`,
    images: [carchi1, carchi2, carchi3, carchi4],
    pos: "object-[center_65%]",
    gpx: "/routes/sigchos-quilotoa.gpx"
  },
  {
    monthKey: "NOV",
    label: "NOVIEMBRE",
    dateBadge: "SÁB 21 – DOM 22 NOV 2026",
    tag: "2 DÍAS · EL MAR COMO DESTINO",
    name: "A la Playa en Bici",
    km: "280 km",
    alt: "+3.300 m",
    level: "Avanzado",
    blurb: `<p class="font-semibold italic text-epic-blue/90">Dos días. Una ruta. El mar como destino.</p><p>Una experiencia que combina bicicleta, naturaleza y libertad, conectando la Sierra con la Costa a través de una ruta diseñada para disfrutar cada kilómetro.</p><p>Partimos desde <strong>Quito y descendemos hacia Pedernales</strong>, atravesando paisajes que cambian a cada pedalada. Dos días para disfrutar de la ruta, compartir con otros ciclistas y vivir esa sensación única de llegar al mar después de haberlo conquistado en bicicleta.</p><p><strong>280K · +3.300 m de desnivel.</strong> Todo está pensado para que tú solo te concentres en disfrutar: acompañamiento, abastecimiento y seguridad durante el recorrido.</p><p>Una experiencia para pedalear, desconectar y celebrar el camino.</p><p class="font-semibold text-epic-blue">DE LA SIERRA A LA COSTA. EN BICICLETA.</p>`,
    images: [playa1, playa2, playa3, playa4, playa5],
    pos: "object-[center_30%]",
    gpx: "/routes/sigchos-quilotoa.gpx"
  },
  {
    monthKey: "DIC",
    label: "DICIEMBRE",
    dateBadge: "FECHA POR CONFIRMAR",
    tag: "RUTA ANDINA",
    name: "Quisapincha",
    km: "150 km",
    alt: "+2.400 m",
    level: "Medio",
    blurb: `<p class="font-semibold italic text-epic-blue/90">Una ruta que conecta la ciudad, la montaña y la esencia de los Andes.</p><p>Descubre <strong>Quisapincha</strong> sobre dos ruedas, en una experiencia que combina desafío, cultura y paisajes únicos. Partimos desde Quito y atravesamos el Chasqui, continuamos hacia Latacunga y Ambato, hasta afrontar la subida emblemática que nos llevará a la comunidad de Quisapincha.</p><p>A lo largo de <strong>150 kilómetros y +2.400 metros de desnivel positivo</strong>, esta ruta de nivel medio nos invita a disfrutar cada tramo a nuestro propio ritmo, mientras atravesamos diferentes paisajes y descubrimos la riqueza de los Andes.</p><p>Una experiencia cuidadosamente planificada, con respaldo, seguridad y logística en cada etapa, para que solo tengas que concentrarte en pedalear, disfrutar del camino y compartir la pasión por el ciclismo.</p><p class="font-semibold text-epic-blue">Porque algunas rutas no se miden solo en kilómetros, sino en todo lo que descubres mientras las recorres.</p>`,
    images: [quisapincha1, quisapincha2, quisapincha3],
    pos: "object-[center_60%]",
    gpx: "/routes/sigchos-quilotoa.gpx"
  }
];
---

<section id="sec-calendario" class="py-20 lg:py-28 bg-epic-gray-bg border-b border-epic-blue/10 scroll-mt-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-12">
    
    <!-- Section Title -->
    <div class="max-w-3xl mb-12">
      <h2 class="font-black text-3xl sm:text-5xl lg:text-6xl tracking-tight text-epic-blue leading-tight">
        PRÓXIMAS RODADAS 2026
      </h2>
      <p class="text-epic-text-muted text-base mt-2">
        Elige tu próximo desafío. Cada evento incluye traslado de bicicleta en furgoneta adaptada, hidratación, carro escoba y fotos oficiales.
      </p>
    </div>

    <!-- Paseos Tabs Navigation -->
    <div class="flex overflow-x-auto pb-2 mb-8 border-b-2 border-epic-blue/10 gap-1.5 sm:gap-2 lg:gap-2.5 scrollbar-none -mx-4 px-4 sm:mx-0 sm:px-0">
      {events.map((ev, index) => (
        <button 
          type="button"
          class={`calendar-tab shrink-0 lg:flex-1 py-3 sm:py-3.5 px-3.5 sm:px-4 lg:px-2 text-center font-extrabold text-xs xl:text-sm tracking-wide transition-all duration-200 border-0 border-b-4 -mb-[2px] cursor-pointer outline-none focus:outline-none focus-visible:outline-none focus:ring-0 focus-visible:ring-0 active:outline-none select-none whitespace-nowrap ${index === 0 ? 'border-b-epic-gold text-epic-blue bg-white/70 rounded-t-xl' : 'border-b-transparent text-epic-text-muted hover:text-epic-blue'}`}
          data-tab={index}
        >
          <span>{ev.name}</span>
        </button>
      ))}
    </div>

    <!-- Event Detail Cards (Editorial High-Impact 50/50 Layout) -->
    <div class="relative bg-white rounded-3xl overflow-hidden border border-epic-blue/10 shadow-2xl">
      {events.map((ev, index) => (
        <div 
          class={`calendar-event-card grid grid-cols-1 lg:grid-cols-12 transition-all duration-300 ${index === 0 ? 'grid' : 'hidden'}`}
          data-event-index={index}
        >
          <!-- Full-Bleed Grand Photo Column with Crossfade Transition & Multiple Images (Left 6/12) -->
          <div 
            class="calendar-slider-container lg:col-span-6 relative min-h-[320px] sm:min-h-[400px] lg:min-h-[480px] bg-epic-gray-bg overflow-hidden group select-none"
            data-event-index={index}
          >
            <!-- Images Slides / Crossfade Layers -->
            <div class="absolute inset-0 w-full h-full">
              {ev.images.map((img, imgIdx) => (
                <div 
                  class={`calendar-slide absolute inset-0 w-full h-full transition-opacity duration-700 ease-in-out cursor-pointer ${imgIdx === 0 ? 'opacity-100 z-10 pointer-events-auto' : 'opacity-0 z-0 pointer-events-none'}`}
                  data-slide-index={imgIdx}
                  role="button"
                  tabindex={imgIdx === 0 ? "0" : "-1"}
                  aria-label={`Ampliar fotografía de ${ev.name}`}
                  onclick={`window.openCalendarImageModal(${index})`}
                  onkeydown={`if(event.key==='Enter'||event.key===' '){event.preventDefault();window.openCalendarImageModal(${index});}`}
                >
                  <Image 
                    src={img} 
                    alt={`${ev.name} - Foto ${imgIdx + 1}`} 
                    width={600}
                    height={450}
                    class={`w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out ${ev.pos || 'object-center'}`}
                    widths={[360, 500, 720]}
                    sizes="(max-width: 640px) 250px, (max-width: 1024px) 500px, 600px"
                    quality={55}
                    format="webp"
                    loading={imgIdx === 0 ? "eager" : "lazy"}
                    decoding="async"
                  />
                </div>
              ))}
            </div>


            <!-- Photo Counter Badge (e.g. 1 / 5) -->
            {ev.images.length > 1 && (
              <div class="absolute top-4 right-4 sm:top-6 sm:right-6 z-20 pointer-events-none">
                <span class="slide-counter inline-flex items-center bg-black/60 backdrop-blur-md text-white font-mono font-bold text-[11px] sm:text-xs px-2.5 py-1 rounded-full shadow-lg border border-white/10">
                  1 / {ev.images.length}
                </span>
              </div>
            )}

            <!-- Navigation Chevrons (Prev / Next) -->
            {ev.images.length > 1 && (
              <div class="absolute inset-x-2 sm:inset-x-3 top-1/2 -translate-y-1/2 flex items-center justify-between z-20 pointer-events-none">
                <button 
                  type="button"
                  class="slide-prev-btn pointer-events-auto w-9 h-9 sm:w-10 sm:h-10 rounded-full bg-black/50 hover:bg-black/80 text-white flex items-center justify-center backdrop-blur-sm border border-white/20 shadow-lg opacity-0 group-hover:opacity-100 sm:opacity-60 sm:hover:opacity-100 transition-all transform hover:scale-110 cursor-pointer"
                  aria-label="Foto anterior"
                >
                  <svg class="w-5 h-5 text-epic-gold" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
                  </svg>
                </button>
                <button 
                  type="button"
                  class="slide-next-btn pointer-events-auto w-9 h-9 sm:w-10 sm:h-10 rounded-full bg-black/50 hover:bg-black/80 text-white flex items-center justify-center backdrop-blur-sm border border-white/20 shadow-lg opacity-0 group-hover:opacity-100 sm:opacity-60 sm:hover:opacity-100 transition-all transform hover:scale-110 cursor-pointer"
                  aria-label="Siguiente foto"
                >
                  <svg class="w-5 h-5 text-epic-gold" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                  </svg>
                </button>
              </div>
            )}

            <!-- Bottom Dot Indicators with Accessible Tap Target -->
            {ev.images.length > 1 && (
              <div class="absolute bottom-4 inset-x-0 flex items-center justify-center gap-1 z-20 pointer-events-none">
                {ev.images.map((_, dotIdx) => (
                  <button 
                    type="button"
                    class="slide-dot pointer-events-auto h-9 min-w-[36px] px-1 flex items-center justify-center cursor-pointer group focus:outline-none"
                    data-dot-index={dotIdx}
                    aria-label={`Ir a foto ${dotIdx + 1} de ${ev.name}`}
                  >
                    <span 
                      class={`slide-dot-pill h-2 rounded-full transition-all duration-300 shadow pointer-events-none ${dotIdx === 0 ? 'bg-epic-gold w-6 sm:w-7' : 'bg-white/50 group-hover:bg-white/80 w-2 sm:w-2.5'}`}
                    ></span>
                  </button>
                ))}
              </div>
            )}

            <!-- Accessible Magnifier Button on Hover/Mobile -->
            <button 
              type="button"
              onclick={`window.openCalendarImageModal(${index})`}
              class="absolute bottom-4 right-4 z-20 pointer-events-auto opacity-0 group-hover:opacity-100 sm:opacity-75 sm:hover:opacity-100 transition-opacity duration-300 w-9 h-9 rounded-full bg-black/60 hover:bg-black/90 backdrop-blur-sm border border-white/20 text-white flex items-center justify-center shadow-lg cursor-pointer focus:outline-none"
              aria-label={`Ampliar fotografía oficial de ${ev.name}`}
            >
              <svg class="w-4 h-4 text-epic-gold" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v6m3-3H7" />
              </svg>
            </button>
          </div>

          <!-- Event Data Column (Right 6/12) -->
          <div class="lg:col-span-6 p-6 sm:p-8 lg:p-10 flex flex-col justify-between gap-6">
            <div>
              <div class="flex flex-wrap items-center gap-2 sm:gap-3 mb-3">
                <span class="font-mono text-xs font-bold tracking-widest text-epic-gold uppercase bg-epic-blue px-3 py-1 rounded-md">
                  {ev.tag}
                </span>
                <span class="text-xs font-mono text-epic-text-muted tracking-wider">
                  CUPO LIMITADO: 14 CICLISTAS
                </span>
              </div>

              <h3 class="font-black text-2xl sm:text-3xl lg:text-4xl text-epic-blue tracking-tight mb-4">
                {ev.name}
              </h3>

              <!-- Technical Stats -->
              <dl class="grid grid-cols-3 gap-2 sm:gap-3 py-4 border-y border-epic-blue/10 my-4 bg-epic-gray-bg/50 rounded-xl px-3 sm:px-4 m-0">
                <div class="min-w-0">
                  <dt class="font-mono text-[10px] uppercase tracking-wider text-epic-text-muted block">Distancia</dt>
                  <dd class="font-black text-lg sm:text-2xl text-epic-blue truncate block m-0">{ev.km}</dd>
                </div>
                <div class="min-w-0">
                  <dt class="font-mono text-[10px] uppercase tracking-wider text-epic-text-muted block">Altimetría</dt>
                  <dd class="font-black text-lg sm:text-2xl text-epic-blue truncate block m-0">{ev.alt}</dd>
                </div>
                <div class="min-w-0">
                  <dt class="font-mono text-[10px] uppercase tracking-wider text-epic-text-muted block">Nivel</dt>
                  <dd class="font-black text-sm sm:text-xl text-epic-gold leading-tight break-words block m-0">{ev.level}</dd>
                </div>
              </dl>

              <!-- Scannable and Accessible Route Description (WCAG & UX Typography Rules) -->
              <div class="text-epic-text-muted text-sm sm:text-[15px] leading-relaxed max-w-[65ch] space-y-2.5 text-left font-normal">
                <Fragment set:html={ev.blurb} />
              </div>
            </div>

            <!-- Action Buttons (Clean Centered Booking CTA) -->
            <div class="flex items-center justify-center pt-2">
              <button 
                type="button"
                onclick={`window.openBookingModal('${ev.name}', '${ev.dateBadge}')`}
                class="w-full sm:w-auto bg-epic-blue hover:bg-epic-blue-light text-epic-gold font-extrabold text-xs tracking-wider px-10 py-4 rounded-full text-center transition-all shadow-md uppercase transform hover:scale-105 cursor-pointer"
              >
                Inscribirme / Reservar Cupo
              </button>
            </div>

          </div>
        </div>
      ))}
    </div>

  </div>
</section>

<script define:vars={{ calendarGallery }}>
  // Expose calendar gallery globally for Modals lightbox
  window.calendarRoutesGallery = calendarGallery;

  const tabs = document.querySelectorAll('.calendar-tab');
  const cards = document.querySelectorAll('.calendar-event-card');
  const sliderContainers = document.querySelectorAll('.calendar-slider-container');
  let currentActiveTab = 0;
  let autoplayInterval = null;

  function initSliders() {
    sliderContainers.forEach((container) => {
      const slides = container.querySelectorAll('.calendar-slide');
      const dots = container.querySelectorAll('.slide-dot');
      const counter = container.querySelector('.slide-counter');
      const prevBtn = container.querySelector('.slide-prev-btn');
      const nextBtn = container.querySelector('.slide-next-btn');
      const total = slides.length;
      if (total <= 1) return;

      let currentSlide = 0;

      function updateSlide(nextIndex) {
        currentSlide = (nextIndex + total) % total;

        slides.forEach((s, idx) => {
          if (idx === currentSlide) {
            const currentImg = s.querySelector('img');
            if (currentImg instanceof HTMLImageElement && currentImg.loading === 'lazy') {
              currentImg.loading = 'eager';
            }
            s.classList.remove('opacity-0', 'z-0', 'pointer-events-none');
            s.classList.add('opacity-100', 'z-10', 'pointer-events-auto');
          } else {
            s.classList.remove('opacity-100', 'z-10', 'pointer-events-auto');
            s.classList.add('opacity-0', 'z-0', 'pointer-events-none');
          }
        });

        const nextSlideIdx = (currentSlide + 1) % total;
        const nextImg = slides[nextSlideIdx]?.querySelector('img');
        if (nextImg instanceof HTMLImageElement && nextImg.loading === 'lazy') {
          nextImg.loading = 'eager';
        }

        dots.forEach((d, idx) => {
          const pill = d.querySelector('.slide-dot-pill') || d;
          if (idx === currentSlide) {
            pill.classList.remove('bg-white/50', 'w-2', 'sm:w-2.5');
            pill.classList.add('bg-epic-gold', 'w-6', 'sm:w-7');
          } else {
            pill.classList.remove('bg-epic-gold', 'w-6', 'sm:w-7');
            pill.classList.add('bg-white/50', 'w-2', 'sm:w-2.5');
          }
        });

        if (counter) {
          counter.textContent = `${currentSlide + 1} / ${total}`;
        }
      }

      if (prevBtn) {
        prevBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          updateSlide(currentSlide - 1);
          resetAutoplay();
        });
      }

      if (nextBtn) {
        nextBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          updateSlide(currentSlide + 1);
          resetAutoplay();
        });
      }

      dots.forEach((dot) => {
        dot.addEventListener('click', (e) => {
          e.stopPropagation();
          const targetDot = Number(dot.getAttribute('data-dot-index'));
          updateSlide(targetDot);
          resetAutoplay();
        });
      });

      // Touch swipe support
      let touchStartX = 0;
      let touchEndX = 0;
      container.addEventListener('touchstart', (e) => {
        touchStartX = e.changedTouches[0].screenX;
      }, { passive: true });

      container.addEventListener('touchend', (e) => {
        touchEndX = e.changedTouches[0].screenX;
        const diff = touchStartX - touchEndX;
        if (Math.abs(diff) > 40) {
          if (diff > 0) {
            updateSlide(currentSlide + 1);
          } else {
            updateSlide(currentSlide - 1);
          }
          resetAutoplay();
        }
      }, { passive: true });

      container._goToNextSlide = () => updateSlide(currentSlide + 1);
    });
  }

  function startAutoplay() {
    stopAutoplay();
    autoplayInterval = setInterval(() => {
      const activeCard = cards[currentActiveTab];
      if (activeCard) {
        const activeSlider = activeCard.querySelector('.calendar-slider-container');
        if (activeSlider && typeof activeSlider._goToNextSlide === 'function') {
          activeSlider._goToNextSlide();
        }
      }
    }, 3800);
  }

  function stopAutoplay() {
    if (autoplayInterval) {
      clearInterval(autoplayInterval);
      autoplayInterval = null;
    }
  }

  function resetAutoplay() {
    startAutoplay();
  }

  sliderContainers.forEach(container => {
    container.addEventListener('mouseenter', stopAutoplay);
    container.addEventListener('mouseleave', startAutoplay);
  });

  initSliders();

  const calendarSection = document.getElementById('sec-calendario');
  const warmUpCalendarImages = () => {
    document.querySelectorAll('.calendar-slide img').forEach((img) => {
      if (img instanceof HTMLImageElement) {
        if (img.loading === 'lazy') {
          img.loading = 'eager';
        }
        if (img.decode) {
          img.decode().catch(() => {});
        }
      }
    });
  };

  if (calendarSection && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          startAutoplay();
          warmUpCalendarImages();
        } else {
          stopAutoplay();
        }
      });
    }, { rootMargin: '250px' });
    observer.observe(calendarSection);
  } else {
    startAutoplay();
  }

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      const targetIndex = Number(tab.getAttribute('data-tab'));
      currentActiveTab = targetIndex;
      resetAutoplay();

      tabs.forEach((t, i) => {
        if (i === targetIndex) {
          t.classList.remove('border-b-transparent', 'text-epic-text-muted');
          t.classList.add('border-b-epic-gold', 'text-epic-blue', 'bg-white/70', 'rounded-t-xl');
        } else {
          t.classList.remove('border-b-epic-gold', 'text-epic-blue', 'bg-white/70', 'rounded-t-xl');
          t.classList.add('border-b-transparent', 'text-epic-text-muted');
        }
      });

      cards.forEach((c, i) => {
        if (i === targetIndex) {
          c.classList.remove('hidden');
          c.classList.add('grid');
        } else {
          c.classList.remove('grid');
          c.classList.add('hidden');
        }
      });
    });
  });
</script>

