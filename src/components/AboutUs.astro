---
// AboutUs.astro
import { Image } from 'astro:assets';
import slide1 from '../assets/nosotros/caro-daniel-fundadores.jpg';
import slide2 from '../assets/nosotros/caro-epic-van.jpg';
import slide3 from '../assets/nosotros/peloton-van-soporte.jpg';
import slide4 from '../../public/images/PAGINA WEB/DESCRIPCION GENERAL - QUIENES SOMOS/Daniel.jpg';
import slide5 from '../../public/images/PAGINA WEB/DESCRIPCION GENERAL - QUIENES SOMOS/Caro-y-Daniel-3.jpg';

const bannerSlides = [
  {
    num: "01",
    label: "Caro & Daniel — Fundadores de EPIC Rides",
    img: slide1,
    pos: "object-[center_20%]"
  },
  {
    num: "02",
    label: "Caro y la Epic Van de soporte logístico",
    img: slide2,
    pos: "object-center"
  },
  {
    num: "03",
    label: "Pelotón en ruta con escolta y asistencia",
    img: slide3,
    pos: "object-center"
  },
  {
    num: "04",
    label: "Daniel, nuestra furgoneta y equipo de guías",
    img: slide4,
    pos: "object-[center_30%]"
  },
  {
    num: "05",
    label: "Campamento, fogata y paisajes andinos",
    img: slide5,
    pos: "object-center"
  }
];
---

<section id="sec-nosotros" class="py-20 lg:py-28 bg-white border-b border-epic-blue/10 scroll-mt-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-12">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      
      <!-- Interactive Carousel (Left) -->
      <div class="relative h-[380px] sm:h-[480px] rounded-2xl overflow-hidden shadow-2xl bg-epic-blue-card group">
        
        <!-- Slides -->
        <div id="about-slides-container" class="relative w-full h-full">
          {bannerSlides.map((slide, index) => (
            <div 
              class={`about-slide absolute inset-0 transition-opacity duration-700 ease-in-out ${index === 0 ? 'opacity-100 z-10' : 'opacity-0 z-0'}`}
              data-index={index}
            >
              <Image 
                src={slide.img} 
                alt={slide.label} 
                class={`w-full h-full object-cover ${slide.pos || 'object-center'}`}
                widths={[360, 480, 600]}
                sizes="(max-width: 640px) calc(100vw - 32px), (max-width: 1024px) 50vw, 550px"
                quality={68}
                format="webp"
                loading={index === 0 ? "eager" : "lazy"}
                decoding="async"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-epic-blue/90 via-transparent to-black/20"></div>
              
              <!-- Slide Label Overlay -->
              <div class="absolute bottom-12 left-6 right-6 flex items-end justify-between">
                <div>
                  <span class="font-mono text-3xl sm:text-4xl font-black text-epic-gold block">{slide.num}</span>
                  <p class="text-white text-sm sm:text-base font-bold drop-shadow-md">{slide.label}</p>
                </div>
              </div>
            </div>
          ))}
        </div>

        
       

        <!-- Indicator Bars (Bottom) -->
        <div class="absolute bottom-5 left-6 right-6 z-20 flex gap-2">
          {bannerSlides.map((_, index) => (
            <button 
              type="button"
              class="slide-indicator-dot flex-1 py-3 group cursor-pointer focus:outline-none"
              data-target={index}
              aria-label={`Ir a foto ${index + 1}`}
            >
              <span class={`slide-bar block h-1.5 rounded-full transition-all duration-300 ${index === 0 ? 'bg-epic-gold' : 'bg-white/30 group-hover:bg-white/60'}`}></span>
            </button>
          ))}
        </div>

      </div>

      <!-- Story Text (Right) -->
      <div class="flex flex-col gap-6 justify-center">
        <h2 class="font-black text-3xl sm:text-5xl lg:text-[46px] tracking-tight text-epic-blue leading-[1.05]">
          BIENVENIDOS.<br />
          <span class="text-epic-blue">SOMOS </span><span class="text-epic-gold">CARO Y DANIEL</span>
        </h2>

        <p class="text-epic-text-muted text-base sm:text-lg leading-relaxed">
          Además de ser los fundadores, estamos detrás de cada detalle de <strong class="text-epic-blue">EPIC Rides</strong>, asegurando que cada experiencia esté cuidadosamente diseñada y ejecutada.
        </p>

        <p class="text-epic-text-muted text-base leading-relaxed">
          Somos ciclistas desde hace más de 10 años y convertimos nuestra pasión por la bicicleta en una forma de vida. Esa experiencia nos permite comprender lo que realmente busca un ciclista: <strong class="text-epic-blue">rutas memorables, buena organización, seguridad, confianza y el respaldo de un equipo que comparte su misma pasión</strong>.
        </p>

        <p class="text-epic-text-muted text-sm leading-relaxed italic border-l-2 border-epic-gold pl-4">
          "Durante cada paseo podrás compartir con nosotros en algunos momentos de la experiencia, recorriendo juntos los destinos que hemos seleccionado y descubriendo Ecuador desde una perspectiva diferente: sobre dos ruedas."
        </p>



      </div>

    </div>
  </div>
</section>

<script>
  let currentSlide = 0;
  const slides = document.querySelectorAll('.about-slide');
  const dots = document.querySelectorAll('.slide-indicator-dot');
  const totalSlides = slides.length;
  let autoplayTimer: any;

  function showSlide(index: number) {
    slides.forEach((s, i) => {
      if (i === index) {
        s.classList.remove('opacity-0', 'z-0');
        s.classList.add('opacity-100', 'z-10');
      } else {
        s.classList.remove('opacity-100', 'z-10');
        s.classList.add('opacity-0', 'z-0');
      }
    });

    dots.forEach((d, i) => {
      const bar = d.querySelector('.slide-bar') || d;
      if (i === index) {
        bar.classList.remove('bg-white/30');
        bar.classList.add('bg-epic-gold');
      } else {
        bar.classList.remove('bg-epic-gold');
        bar.classList.add('bg-white/30');
      }
    });
    currentSlide = index;
  }

  function nextSlide() {
    showSlide((currentSlide + 1) % totalSlides);
  }

  function prevSlide() {
    showSlide((currentSlide - 1 + totalSlides) % totalSlides);
  }

  document.getElementById('next-slide-btn')?.addEventListener('click', () => {
    nextSlide();
    resetAutoplay();
  });

  document.getElementById('prev-slide-btn')?.addEventListener('click', () => {
    prevSlide();
    resetAutoplay();
  });

  dots.forEach(dot => {
    dot.addEventListener('click', (e) => {
      const btn = (e.currentTarget as HTMLElement) || (e.target as HTMLElement);
      const targetIndex = Number(btn.getAttribute('data-target') || btn.closest('[data-target]')?.getAttribute('data-target'));
      if (!isNaN(targetIndex)) {
        showSlide(targetIndex);
        resetAutoplay();
      }
    });
  });

  function startAutoplay() {
    clearInterval(autoplayTimer);
    autoplayTimer = setInterval(nextSlide, 3500);
  }

  function resetAutoplay() {
    clearInterval(autoplayTimer);
    startAutoplay();
  }

  const aboutSection = document.getElementById('sec-nosotros');
  const warmUpAboutImages = () => {
    document.querySelectorAll('.about-slide img').forEach((img) => {
      if (img instanceof HTMLImageElement) {
        if (img.loading === 'lazy') {
          img.loading = 'eager';
        }
        if (img.decode) {
          img.decode().catch(() => {});
        }
      }
    });
  };

  if (aboutSection && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          startAutoplay();
          warmUpAboutImages();
        } else {
          clearInterval(autoplayTimer);
        }
      });
    }, { rootMargin: '250px' });
    observer.observe(aboutSection);
  } else {
    startAutoplay();
  }

  if ('requestIdleCallback' in window) {
    window.requestIdleCallback(warmUpAboutImages);
  } else {
    setTimeout(warmUpAboutImages, 1800);
  }
</script>
